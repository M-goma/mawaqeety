<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="10dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView android:id="@+id/next_name" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold" android:maxLines="1"/>
            <TextView android:id="@+id/next_time" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#E9C75A" android:textSize="12sp" android:maxLines="1" android:ellipsize="end"/>
            <TextView android:id="@+id/hijri_line" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#CCE9DD" android:textSize="11sp" android:maxLines="1" android:visibility="gone"/>
            <LinearLayout android:id="@+id/badge" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:background="@drawable/widget_badge" android:orientation="horizontal"
                android:gravity="center_vertical" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="1dp" android:paddingBottom="1dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="متبقٍ "
                    android:textColor="#FFFFFF" android:textSize="12sp"/>
                <Chronometer android:id="@+id/countdown_small" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layoutDirection="ltr" android:textColor="#E9C75A" android:textSize="13sp" android:textStyle="bold"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/clock_box" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="end">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layoutDirection="ltr" android:gravity="bottom">
                <TextClock android:id="@+id/clock" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:format12Hour="h:mm" android:format24Hour="HH:mm" android:textColor="#FFFFFF"
                    android:textSize="34sp" android:textStyle="bold" android:fontFamily="sans-serif-condensed" android:includeFontPadding="false"/>
                <TextClock android:id="@+id/clock_sec" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:format12Hour=":ss" android:format24Hour=":ss" android:textColor="#B3FFFFFF"
                    android:textSize="16sp" android:fontFamily="sans-serif-condensed" android:includeFontPadding="false"/>
            </LinearLayout>
            <TextView android:id="@+id/clock_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#CCE9DD" android:textSize="11sp" android:text="الساعة الآن"/>
        </LinearLayout>
        <Chronometer android:id="@+id/countdown" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layoutDirection="ltr" android:textColor="#FFFFFF" android:textSize="26sp" android:textStyle="bold"
            android:fontFamily="sans-serif-condensed" android:visibility="gone"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/c0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">
            <TextView android:id="@+id/n0" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#CCE9DD" android:textSize="11sp" android:maxLines="1"/>
            <TextView android:id="@+id/t0" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layoutDirection="ltr" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" android:maxLines="1"/>
            <Chronometer android:id="@+id/cd0" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layoutDirection="ltr" android:textColor="#E9C75A" android:textSize="10sp" android:visibility="gone"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/c1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">
            <TextView android:id="@+id/n1" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#CCE9DD" android:textSize="11sp" android:maxLines="1"/>
            <TextView android:id="@+id/t1" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layoutDirection="ltr" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" android:maxLines="1"/>
            <Chronometer android:id="@+id/cd1" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layoutDirection="ltr" android:textColor="#E9C75A" android:textSize="10sp" android:visibility="gone"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/c2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">
            <TextView android:id="@+id/n2" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#CCE9DD" android:textSize="11sp" android:maxLines="1"/>
            <TextView android:id="@+id/t2" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layoutDirection="ltr" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" android:maxLines="1"/>
            <Chronometer android:id="@+id/cd2" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layoutDirection="ltr" android:textColor="#E9C75A" android:textSize="10sp" android:visibility="gone"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/c3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">
            <TextView android:id="@+id/n3" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#CCE9DD" android:textSize="11sp" android:maxLines="1"/>
            <TextView android:id="@+id/t3" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layoutDirection="ltr" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" android:maxLines="1"/>
            <Chronometer android:id="@+id/cd3" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layoutDirection="ltr" android:textColor="#E9C75A" android:textSize="10sp" android:visibility="gone"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/c4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">
            <TextView android:id="@+id/n4" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#CCE9DD" android:textSize="11sp" android:maxLines="1"/>
            <TextView android:id="@+id/t4" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layoutDirection="ltr" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" android:maxLines="1"/>
            <Chronometer android:id="@+id/cd4" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layoutDirection="ltr" android:textColor="#E9C75A" android:textSize="10sp" android:visibility="gone"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/c5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">
            <TextView android:id="@+id/n5" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#CCE9DD" android:textSize="11sp" android:maxLines="1"/>
            <TextView android:id="@+id/t5" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layoutDirection="ltr" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" android:maxLines="1"/>
            <Chronometer android:id="@+id/cd5" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layoutDirection="ltr" android:textColor="#E9C75A" android:textSize="10sp" android:visibility="gone"/>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/date_line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:textColor="#CCE9DD"
        android:textSize="11sp"
        android:maxLines="1"
        android:ellipsize="end"/>
</LinearLayout>
