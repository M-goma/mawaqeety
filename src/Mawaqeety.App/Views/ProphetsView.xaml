<UserControl x:Class="Mawaqeety.App.Views.ProphetsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Mawaqeety.App.Controls">
    <UserControl.Resources>
        <c:BoolToVisibilityConverter x:Key="BoolVis"/>
        <c:NotEmptyToVisibilityConverter x:Key="NotEmpty"/>
    </UserControl.Resources>

    <Grid Margin="24,24,24,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- List of the 25 prophets -->
        <Border Style="{StaticResource Card}" Padding="8" Margin="0">
            <ListBox ItemsSource="{Binding Prophets}" SelectedItem="{Binding Selected}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="10" Background="{DynamicResource HeroBrush}" Margin="0,0,10,0">
                                <TextBlock Text="{Binding OrderText}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock DockPanel.Dock="Right" Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                                       Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="6,0,2,0" ToolTip="محفوظة على الجهاز"
                                       Visibility="{Binding IsSaved, Converter={StaticResource BoolVis}}"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Prophet.Title}" FontSize="12" Foreground="{DynamicResource GoldBrush}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Story -->
        <ScrollViewer x:Name="StoryScroll" Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="860" Margin="0,0,8,24">
                <Border Background="{DynamicResource HeroBrush}" CornerRadius="18" Padding="24,20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" Foreground="White" FontSize="28" FontWeight="Bold"/>
                        <TextBlock Text="{Binding Subtitle}" Foreground="#E9C75A" FontSize="15"/>
                        <TextBlock Text="{Binding Summary}" Foreground="#E6F3EE" FontSize="14.5" TextWrapping="Wrap" Margin="0,10,0,0" LineHeight="26"/>
                        <WrapPanel Margin="0,14,0,0">
                            <Button Command="{Binding NarrateCommand}" Padding="16,6" Background="#26FFFFFF" Foreground="White" BorderBrush="#66FFFFFF">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding NarrateGlyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,2,8,0"/>
                                    <TextBlock Text="{Binding NarrateLabel}"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding StopAudioCommand}" Margin="8,0,0,0" Padding="10,6" Background="#26FFFFFF" Foreground="White"
                                    BorderBrush="#66FFFFFF" ToolTip="إيقاف الصوت">
                                <TextBlock Text="&#xE71A;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"/>
                            </Button>
                            <Button Command="{Binding SeekBackCommand}" Margin="8,0,0,0" Padding="8,6" Background="#26FFFFFF" Foreground="White"
                                    BorderBrush="#66FFFFFF" ToolTip="رجوع ١٥ ثانية" Visibility="{Binding IsNarrating, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="&#xED3C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"/>
                            </Button>
                            <Button Command="{Binding SeekForwardCommand}" Margin="4,0,0,0" Padding="8,6" Background="#26FFFFFF" Foreground="White"
                                    BorderBrush="#66FFFFFF" ToolTip="تقديم ١٥ ثانية" Visibility="{Binding IsNarrating, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="&#xED3D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"/>
                            </Button>
                            <ComboBox Width="170" Margin="10,0,0,0" ItemsSource="{Binding VoiceOptions}" DisplayMemberPath="Value"
                                      SelectedValuePath="Key" SelectedValue="{Binding NarrationVoice}" ToolTip="صوت القارئ للقصة"/>
                            <ToggleButton IsChecked="{Binding Autoplay}" Margin="10,0,0,0" Padding="12,6" ToolTip="عند انتهاء القصة تبدأ القصة التالية بعد ٥ ثوانٍ">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8EE;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,2,6,0"/>
                                    <TextBlock Text="تلقائي"/>
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton x:Name="StoriesDl" IsChecked="{Binding StoriesDownloadOpen}" Margin="10,0,0,0" Padding="12,6"
                                          ToolTip="تنزيل القصص للاستماع دون إنترنت">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,2,6,0"/>
                                    <TextBlock Text="تنزيل القصص"/>
                                </StackPanel>
                            </ToggleButton>
                            <Popup IsOpen="{Binding StoriesDownloadOpen}" PlacementTarget="{Binding ElementName=StoriesDl}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="14" Padding="18" Width="380" Margin="6">
                                    <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.35"/></Border.Effect>
                                    <StackPanel>
                                        <TextBlock Text="تنزيل القصص للاستماع دون إنترنت" FontWeight="Bold" FontSize="15"/>
                                        <TextBlock Text="{Binding StoriesSavedText}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,10"/>
                                        <RadioButton GroupName="sv" Content="{Binding MaleSizeText}" IsChecked="{Binding IsMaleChoice}" Margin="0,3"/>
                                        <RadioButton GroupName="sv" Content="{Binding FemaleSizeText}" IsChecked="{Binding IsFemaleChoice}" Margin="0,3"/>
                                        <RadioButton GroupName="sv" Content="{Binding BothSizeText}" IsChecked="{Binding IsBothChoice}" Margin="0,3"/>
                                        <WrapPanel Margin="0,10,0,0">
                                            <Button Style="{StaticResource PrimaryButton}" Content="تنزيل كل القصص" Command="{Binding DownloadAllStoriesCommand}" Padding="12,5" Margin="0,0,6,6"
                                                    IsEnabled="{Binding Downloads.StoriesRunning, Converter={x:Static c:Not.Instance}}"/>
                                            <Button Content="تنزيل هذه القصة فقط" Command="{Binding DownloadThisStoryCommand}" Padding="12,5" Margin="0,0,6,6"
                                                    IsEnabled="{Binding Downloads.StoriesRunning, Converter={x:Static c:Not.Instance}}"/>
                                        </WrapPanel>
                                        <Button Style="{StaticResource GhostButton}" Content="حذف القصص المحفوظة" Command="{Binding DeleteStoriesCommand}"
                                                Foreground="{DynamicResource DangerBrush}" HorizontalAlignment="Left"/>
                                        <TextBlock Style="{StaticResource Muted}" FontSize="11.5" TextWrapping="Wrap" Margin="0,6,0,0"
                                                   Text="يستمر التنزيل إذا أغلقت النافذة، ويظهر تقدّمه على أيقونة شريط المهام، ثم يصلك إشعار عند انتهائه."/>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </WrapPanel>
                        <DockPanel Margin="0,10,0,0" Visibility="{Binding Downloads.StoriesText, Converter={StaticResource NotEmpty}}">
                            <Button DockPanel.Dock="Right" Content="إيقاف" Command="{Binding CancelStoriesDownloadCommand}" Padding="10,3"
                                    Visibility="{Binding Downloads.StoriesRunning, Converter={StaticResource BoolVis}}"/>
                            <TextBlock Text="{Binding Downloads.StoriesText}" Foreground="#E9C75A" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </DockPanel>
                        <Border Margin="0,12,0,0" Padding="12,8" CornerRadius="10" Background="#33000000"
                                Visibility="{Binding NextPending, Converter={StaticResource BoolVis}}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="إلغاء" Command="{Binding CancelNextCommand}" Padding="10,3" Margin="6,0,0,0"
                                        Background="#26FFFFFF" Foreground="White" BorderBrush="#66FFFFFF"/>
                                <Button DockPanel.Dock="Right" Content="تشغيل الآن" Command="{Binding PlayNextNowCommand}" Padding="10,3"
                                        Background="#26FFFFFF" Foreground="White" BorderBrush="#66FFFFFF"/>
                                <TextBlock Text="{Binding NextText}" Foreground="#E9C75A" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Border>
                <TextBlock Text="{Binding AudioStatus}" TextWrapping="Wrap" Foreground="{DynamicResource GoldBrush}" Margin="4,0,4,12"
                           Visibility="{Binding AudioStatus, Converter={StaticResource NotEmpty}}"/>

                <ItemsControl ItemsSource="{Binding Sections}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,4,0,12">
                                <DockPanel Margin="0,0,0,8">
                                    <Border Width="4" Height="22" Background="{DynamicResource GoldBrush}" Margin="0,0,10,0" DockPanel.Dock="Left"/>
                                    <TextBlock Text="{Binding Heading}" FontSize="19" FontWeight="Bold"/>
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding Paragraphs}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" TextAlignment="Justify" FontSize="15.5"
                                                       LineHeight="30" Margin="0,0,0,10" Foreground="{DynamicResource TextBrush}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Visibility="{Binding HasAyat, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="من آيات القرآن الكريم" FontSize="19" FontWeight="Bold" Margin="0,8,0,8"/>
                    <ItemsControl ItemsSource="{Binding Ayat}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Text}" FontFamily="{StaticResource QuranFont}" FontSize="23" TextWrapping="Wrap"
                                                   TextAlignment="Justify" LineHeight="46" LineStackingStrategy="BlockLineHeight"
                                                   Foreground="{DynamicResource TextBrush}"/>
                                        <DockPanel Margin="0,6,0,0">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}"
                                                    Command="{Binding DataContext.ReciteAyatCommand, RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=1}}"
                                                    CommandParameter="{Binding}" Foreground="{DynamicResource GoldBrush}" ToolTip="استماع للتلاوة بصوت القارئ المختار">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE768;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,2,6,0"/>
                                                    <TextBlock Text="استماع"/>
                                                </StackPanel>
                                            </Button>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="فتح في المصحف"
                                                    Command="{Binding DataContext.OpenInQuranCommand, RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=1}}"
                                                    CommandParameter="{Binding}" Foreground="{DynamicResource AccentBrush}"/>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Reference}" Foreground="{DynamicResource GoldBrush}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Note}" Style="{StaticResource Muted}" FontSize="12.5"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Visibility="{Binding HasLessons, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="دروس وعبر" FontSize="19" FontWeight="Bold" Margin="0,8,0,8"/>
                    <ItemsControl ItemsSource="{Binding Lessons}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,3">
                                    <TextBlock DockPanel.Dock="Left" Text="&#xE735;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               Foreground="{DynamicResource GoldBrush}" Margin="0,6,10,0" FontSize="12"/>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="15" LineHeight="28"/>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,16,0,0"
                           Text="القصص مستندة إلى القرآن الكريم والسنة الصحيحة (البخاري ومسلم)، دون الإسرائيليات. الآيات معروضة من نص المصحف مباشرة."/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
