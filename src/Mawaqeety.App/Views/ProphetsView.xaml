<UserControl x:Class="Mawaqeety.App.Views.ProphetsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Mawaqeety.App.Controls">
    <UserControl.Resources>
        <c:BoolToVisibilityConverter x:Key="BoolVis"/>
    </UserControl.Resources>

    <Grid Margin="24,24,24,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- List of the 25 prophets -->
        <Border Style="{StaticResource Card}" Padding="8" Margin="0">
            <ListBox ItemsSource="{Binding Prophets}" SelectedItem="{Binding Selected}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="10" Background="{DynamicResource HeroBrush}" Margin="0,0,10,0">
                                <TextBlock Text="{Binding OrderText}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Prophet.Title}" FontSize="12" Foreground="{DynamicResource GoldBrush}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Story -->
        <ScrollViewer x:Name="StoryScroll" Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="860" Margin="0,0,8,24">
                <Border Background="{DynamicResource HeroBrush}" CornerRadius="18" Padding="24,20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" Foreground="White" FontSize="28" FontWeight="Bold"/>
                        <TextBlock Text="{Binding Subtitle}" Foreground="#E9C75A" FontSize="15"/>
                        <TextBlock Text="{Binding Summary}" Foreground="#E6F3EE" FontSize="14.5" TextWrapping="Wrap" Margin="0,10,0,0" LineHeight="26"/>
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding Sections}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,4,0,12">
                                <DockPanel Margin="0,0,0,8">
                                    <Border Width="4" Height="22" Background="{DynamicResource GoldBrush}" Margin="0,0,10,0" DockPanel.Dock="Left"/>
                                    <TextBlock Text="{Binding Heading}" FontSize="19" FontWeight="Bold"/>
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding Paragraphs}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" TextAlignment="Justify" FontSize="15.5"
                                                       LineHeight="30" Margin="0,0,0,10" Foreground="{DynamicResource TextBrush}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Visibility="{Binding HasAyat, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="من آيات القرآن الكريم" FontSize="19" FontWeight="Bold" Margin="0,8,0,8"/>
                    <ItemsControl ItemsSource="{Binding Ayat}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Text}" FontFamily="{StaticResource QuranFont}" FontSize="23" TextWrapping="Wrap"
                                                   TextAlignment="Justify" LineHeight="46" LineStackingStrategy="BlockLineHeight"
                                                   Foreground="{DynamicResource TextBrush}"/>
                                        <DockPanel Margin="0,6,0,0">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="فتح في المصحف"
                                                    Command="{Binding DataContext.OpenInQuranCommand, RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=1}}"
                                                    CommandParameter="{Binding}" Foreground="{DynamicResource AccentBrush}"/>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Reference}" Foreground="{DynamicResource GoldBrush}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Note}" Style="{StaticResource Muted}" FontSize="12.5"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Visibility="{Binding HasLessons, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="دروس وعبر" FontSize="19" FontWeight="Bold" Margin="0,8,0,8"/>
                    <ItemsControl ItemsSource="{Binding Lessons}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,3">
                                    <TextBlock DockPanel.Dock="Left" Text="&#xE735;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               Foreground="{DynamicResource GoldBrush}" Margin="0,6,10,0" FontSize="12"/>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="15" LineHeight="28"/>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,16,0,0"
                           Text="القصص مستندة إلى القرآن الكريم والسنة الصحيحة (البخاري ومسلم)، دون الإسرائيليات. الآيات معروضة من نص المصحف مباشرة."/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
