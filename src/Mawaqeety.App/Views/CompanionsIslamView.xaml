<UserControl x:Class="Mawaqeety.App.Views.CompanionsIslamView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Mawaqeety.App.Controls">
    <UserControl.Resources>
        <c:BoolToVisibilityConverter x:Key="BoolVis"/>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,24" MaxWidth="980">
            <Border Style="{StaticResource HeroCard}">
                <StackPanel>
                    <DockPanel>
                        <TextBlock Text="🤝" Style="{StaticResource HeroEmoji}"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="كيف أسلم الصحابة" Foreground="White" FontSize="28" FontWeight="Bold"/>
                            <TextBlock Text="{Binding HeroSub}" Foreground="#E9C75A" FontSize="14"/>
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Text="{Binding Book.Intro}" Foreground="{DynamicResource HeroMutedBrush}" FontSize="14" TextWrapping="Wrap" LineHeight="26" Margin="0,12,0,0"/>
                    <WrapPanel Margin="0,10,0,0">
                        <Border CornerRadius="10" Background="#26FFFFFF" Padding="10,3" Margin="0,0,8,0">
                            <TextBlock Text="{Binding StatAbuBakr}" Foreground="White" FontWeight="SemiBold" FontSize="12.5"/>
                        </Border>
                        <Border CornerRadius="10" Background="#26FFFFFF" Padding="10,3">
                            <TextBlock Text="{Binding StatHadith}" Foreground="White" FontWeight="SemiBold" FontSize="12.5"/>
                        </Border>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,12">
                            <StackPanel>
                                <DockPanel>
                                    <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="10" Background="{DynamicResource HeroBrush}"
                                            Effect="{StaticResource RaisedShadow}" BorderBrush="{StaticResource RimBrush}" BorderThickness="0,1,0,0" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding NumberText}" Foreground="#E9C75A" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="16"/>
                                        <TextBlock Text="{Binding By}" Foreground="{DynamicResource GoldBrush}" FontWeight="Bold" FontSize="12.5"/>
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock Text="{Binding Story}" TextWrapping="Wrap" FontSize="15" LineHeight="28" Margin="0,8,0,0"/>
                                <WrapPanel Margin="0,8,0,0" Visibility="{Binding HasAge, Converter={StaticResource BoolVis}}">
                                    <Border CornerRadius="8" Background="{DynamicResource GoldSoftBrush}" Padding="8,2" Margin="0,0,6,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE787;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource GoldBrush}" Margin="0,3,5,0"/>
                                            <TextBlock Text="{Binding Age}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource GoldBrush}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border CornerRadius="8" Background="{DynamicResource Surface2Brush}" Padding="8,2"
                                            Visibility="{Binding AgeDisputed, Converter={StaticResource BoolVis}}">
                                        <TextBlock Text="اختلف فيه المؤرخون" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                    </Border>
                                </WrapPanel>
                                <Border Margin="0,10,0,0" Padding="12,8" CornerRadius="0,12,12,0" Background="{DynamicResource GoldSoftBrush}"
                                        BorderBrush="{DynamicResource GoldBrush}" BorderThickness="3,0,0,0"
                                        Visibility="{Binding HasHadith, Converter={StaticResource BoolVis}}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding HadithText}" TextWrapping="Wrap" FontFamily="{StaticResource QuranFont}" FontSize="16.5" LineHeight="32"/>
                                        <TextBlock Text="{Binding HadithRef}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                    </StackPanel>
                                </Border>
                                <ItemsControl ItemsSource="{Binding Sources}" Margin="0,8,0,0">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource GhostButton}" Foreground="{DynamicResource AccentBrush}" ToolTip="{Binding Url}" Padding="6,2" Margin="0,0,6,4"
                                                    Command="{Binding DataContext.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Url}">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Left" Text="&#xE71B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Margin="0,3,5,0"/>
                                                    <TextBlock Text="{Binding Label}" FontSize="11.5" TextWrapping="Wrap"/>
                                                </DockPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="عن المصادر" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="4,8,4,4"/>
            <TextBlock Text="{Binding Book.Footnote}" Style="{StaticResource Muted}" FontSize="12" Margin="4,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
