<UserControl x:Class="Mawaqeety.App.Views.KhatmaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Mawaqeety.App.Controls">
    <UserControl.Resources>
        <c:BoolToVisibilityConverter x:Key="BoolVis"/>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,24" MaxWidth="980">
            <DockPanel Margin="0,0,0,14">
                <Button DockPanel.Dock="Right" Padding="14,6" Command="{Binding BackToMushafCommand}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE736;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,2,8,0"/>
                        <TextBlock Text="العودة إلى المصحف"/>
                    </StackPanel>
                </Button>
                <TextBlock Text="ورد القرآن والختمة" Style="{StaticResource H1}"/>
            </DockPanel>

            <Border Style="{StaticResource HeroCard}">
                <DockPanel>
                    <TextBlock Text="📖" Style="{StaticResource HeroEmoji}"/>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Visibility="{Binding Active, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="{Binding HeroTop}" Foreground="{DynamicResource HeroMutedBrush}" FontSize="15"/>
                            <TextBlock Text="{Binding HeroMain}" Foreground="White" FontSize="30" FontWeight="Bold"/>
                            <ProgressBar Style="{StaticResource HeroProgress}" Value="{Binding Progress, Mode=OneWay}" Margin="0,10,0,6"/>
                        </StackPanel>
                        <TextBlock Text="{Binding HeroSub}" Foreground="#E9C75A" FontSize="14" TextWrapping="Wrap" LineHeight="26"/>
                        <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,12,0,0" Padding="18,8"
                                Command="{Binding ContinueCommand}" Visibility="{Binding Active, Converter={StaticResource BoolVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE736;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,2,8,0"/>
                                <TextBlock Text="{Binding ContinueText}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <TextBlock Text="{Binding PlansTitle}" Style="{StaticResource Section}"/>
            <ItemsControl ItemsSource="{Binding Plans}" Margin="0,0,0,8">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ToggleButton Content="{Binding Label}" IsChecked="{Binding Selected, Mode=OneWay}" Margin="0,0,10,10" Padding="16,8" FontSize="14"
                                      Command="{Binding DataContext.StartPlanCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      CommandParameter="{Binding Days}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <UniformGrid Columns="3" Margin="0,0,-12,0">
                <Border Style="{StaticResource StatTile}"><StackPanel>
                    <TextBlock Text="🏁" FontFamily="Segoe UI Emoji" FontSize="20" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding DoneText}" Style="{StaticResource StatValue}"/>
                    <TextBlock Text="ختمات أتممتها" Style="{StaticResource Muted}" HorizontalAlignment="Center"/></StackPanel></Border>
                <Border Style="{StaticResource StatTile}"><StackPanel>
                    <TextBlock Text="📄" FontFamily="Segoe UI Emoji" FontSize="20" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding TodayText}" Style="{StaticResource StatValue}"/>
                    <TextBlock Text="صفحات اليوم" Style="{StaticResource Muted}" HorizontalAlignment="Center"/></StackPanel></Border>
                <Border Style="{StaticResource StatTile}"><StackPanel>
                    <TextBlock Text="📅" FontFamily="Segoe UI Emoji" FontSize="20" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding WeekText}" Style="{StaticResource StatValue}"/>
                    <TextBlock Text="صفحات الأسبوع" Style="{StaticResource Muted}" HorizontalAlignment="Center"/></StackPanel></Border>
            </UniformGrid>

            <Button HorizontalAlignment="Left" Padding="14,6" Command="{Binding StopCommand}" Margin="0,0,0,12"
                    Visibility="{Binding Active, Converter={StaticResource BoolVis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE71A;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,2,8,0"/>
                    <TextBlock Text="إيقاف الخطة"/>
                </StackPanel>
            </Button>
            <TextBlock Style="{StaticResource Muted}" FontSize="12" LineHeight="22" Margin="4,0"
                       Text="تُحسب الصفحة مقروءة حين تفتحها في المصحف. وتكتمل الختمة عند بلوغ آخر صفحة بعد قراءة المصحف بالترتيب."/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
