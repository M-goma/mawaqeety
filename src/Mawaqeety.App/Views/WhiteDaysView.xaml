<UserControl x:Class="Mawaqeety.App.Views.WhiteDaysView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Mawaqeety.App.Controls">
    <UserControl.Resources>
        <c:BoolToVisibilityConverter x:Key="BoolVis"/>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,24" MaxWidth="980">
            <Border Style="{StaticResource HeroCard}">
                <DockPanel>
                    <TextBlock Text="🤍" Style="{StaticResource HeroEmoji}"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="الأيام البيض القادمة" Foreground="{DynamicResource HeroMutedBrush}" FontSize="15"/>
                        <TextBlock Text="{Binding HeroMain}" Foreground="White" FontSize="30" FontWeight="Bold"/>
                        <TextBlock Text="{Binding HeroSub}" Foreground="#E9C75A" FontSize="14"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="20,8">
                <ItemsControl ItemsSource="{Binding Next}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,8">
                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding Fasted}" IsEnabled="{Binding CanMark}"
                                          VerticalAlignment="Center" ToolTip="صمت هذا اليوم"/>
                                <Border Width="46" Height="46" CornerRadius="23" Background="{DynamicResource GoldSoftBrush}" Margin="0,0,14,0">
                                    <TextBlock Text="{Binding HijriDay}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource GoldBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Gregorian}" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" FontSize="12.5"/>
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
            <TextBlock Text="يمكن تسجيل اليوم بعد أن يحلّ فقط." Style="{StaticResource Muted}" FontSize="12" Margin="4,-6,4,14"/>

            <TextBlock Text="{Binding YearTitle}" Style="{StaticResource Section}"/>
            <Border Style="{StaticResource Card}" Padding="20,10">
                <ItemsControl ItemsSource="{Binding Months}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,5">
                                <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding Cells}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Width="28" Height="28" Margin="6,0,0,0">
                                                <Ellipse x:Name="Dot" Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.2" Opacity="0.3"/>
                                                <TextBlock x:Name="Tick" Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="White"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Started}" Value="True">
                                                    <Setter TargetName="Dot" Property="Opacity" Value="0.7"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Done}" Value="True">
                                                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource AccentBrush}"/>
                                                    <Setter TargetName="Dot" Property="Stroke" Value="{DynamicResource AccentBrush}"/>
                                                    <Setter TargetName="Dot" Property="Opacity" Value="1"/>
                                                    <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding Month}" FontSize="14.5" VerticalAlignment="Center"/>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <Border Style="{StaticResource Card}" Padding="20,14">
                <StackPanel>
                    <TextBlock Text="عن أبي هريرة رضي الله عنه قال: «أوصاني خليلي ﷺ بثلاث: صيام ثلاثة أيام من كل شهر، وركعتي الضحى، وأن أوتر قبل أن أنام»" Style="{StaticResource QuoteText}"/>
                    <TextBlock Text="صحيح البخاري ١٩٨١ • صحيح مسلم ٧٢١" Style="{StaticResource Muted}" FontSize="12"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
