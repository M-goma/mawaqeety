<UserControl x:Class="Mawaqeety.App.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Mawaqeety.App.Localization"
             xmlns:c="clr-namespace:Mawaqeety.App.Controls">
    <UserControl.Resources>
        <c:InverseBoolConverter x:Key="Not"/>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28" MaxWidth="760" HorizontalAlignment="Left">
            <Border Style="{StaticResource Card}" Padding="28">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="pack://application:,,,/Assets/logo.png" Width="72" Height="72" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Mawaqeety – مواقيتي" Style="{StaticResource H1}"/>
                            <TextBlock Text="{l:Tr Slogan}" Foreground="{DynamicResource GoldBrush}" FontSize="15"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Margin="0,18,0,0" Style="{StaticResource Label}">
                        <Run Text="{l:Tr Version}"/><Run Text=" "/><Run Text="{Binding Version, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Text="{l:Tr AboutText}" Style="{StaticResource Muted}" Margin="0,10,0,0" FontSize="14"/>
                    <TextBlock Text="{l:Tr Notice}" Style="{StaticResource Muted}" Margin="0,10,0,0"/>
                    <TextBlock Text="{l:Tr Credits}" Style="{StaticResource Muted}" Margin="0,10,0,0" FontSize="12"/>
                    <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                        <Button Content="{l:Tr CheckUpdates}" Style="{StaticResource PrimaryButton}" Command="{Binding CheckUpdatesCommand}"
                                IsEnabled="{Binding IsChecking, Converter={StaticResource Not}}"/>
                        <TextBlock Text="{Binding UpdateStatus}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="14,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
