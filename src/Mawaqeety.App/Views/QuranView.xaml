<UserControl x:Class="Mawaqeety.App.Views.QuranView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Mawaqeety.App.Controls"
             xmlns:v="clr-namespace:Mawaqeety.App.Views">
    <UserControl.Resources>
        <c:BoolToVisibilityConverter x:Key="BoolVis"/>
        <c:EmptyToVisibilityConverter x:Key="Empty"/>
        <c:NotEmptyToVisibilityConverter x:Key="NotEmpty"/>
    </UserControl.Resources>

    <DockPanel Margin="24,16,24,16">
    <!-- ===== Mushaf / text switch and offline downloads ===== -->
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
        <Border DockPanel.Dock="Left" CornerRadius="10" Background="{DynamicResource SurfaceBrush}" Padding="3">
            <StackPanel Orientation="Horizontal">
                <RadioButton Style="{StaticResource Segment}" Tag="&#xE736;" Content="المصحف" GroupName="qview" IsChecked="{Binding IsMushaf}" MinWidth="110"/>
                <RadioButton Style="{StaticResource Segment}" Tag="&#xE8A5;" Content="نص" GroupName="qview" IsChecked="{Binding IsText}" MinWidth="90"/>
            </StackPanel>
        </Border>
        <ToggleButton x:Name="DlButton" DockPanel.Dock="Right" IsChecked="{Binding DownloadsOpen}" Padding="12,6" ToolTip="الاستماع والقراءة دون إنترنت">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,2,6,0"/>
                <TextBlock Text="التنزيل دون إنترنت"/>
            </StackPanel>
        </ToggleButton>
        <Popup IsOpen="{Binding DownloadsOpen}" PlacementTarget="{Binding ElementName=DlButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="14" Padding="18" Width="420" Margin="6">
                <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.35"/></Border.Effect>
                <StackPanel>
                    <TextBlock Text="التلاوة" FontWeight="Bold" FontSize="15"/>
                    <TextBlock Text="{Binding ReciterSavedText}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,6"/>
                    <TextBlock Text="{Binding Downloads.QuranText}" TextWrapping="Wrap" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,6"
                               Visibility="{Binding Downloads.QuranText, Converter={StaticResource NotEmpty}}"/>
                    <WrapPanel>
                        <Button Content="تنزيل السورة الحالية" Command="{Binding DownloadSurahCommand}" Padding="10,5" Margin="0,0,6,6"
                                IsEnabled="{Binding Downloads.QuranRunning, Converter={x:Static c:Not.Instance}}"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="تنزيل المصحف كاملًا بهذا الصوت" Command="{Binding DownloadAllRecitationCommand}" Padding="10,5" Margin="0,0,6,6"
                                IsEnabled="{Binding Downloads.QuranRunning, Converter={x:Static c:Not.Instance}}"/>
                        <Button Content="إيقاف" Command="{Binding CancelRecitationDownloadCommand}" Padding="10,5" Margin="0,0,6,6"
                                Visibility="{Binding Downloads.QuranRunning, Converter={StaticResource BoolVis}}"/>
                    </WrapPanel>
                    <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,8"/>
                    <TextBlock Text="صفحات المصحف" FontWeight="Bold" FontSize="15"/>
                    <TextBlock Text="{Binding MushafSavedText}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,6"/>
                    <TextBlock Text="{Binding Downloads.MushafText}" TextWrapping="Wrap" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,6"
                               Visibility="{Binding Downloads.MushafText, Converter={StaticResource NotEmpty}}"/>
                    <WrapPanel>
                        <Button Style="{StaticResource PrimaryButton}" Content="تنزيل المصحف كاملًا" Command="{Binding DownloadMushafCommand}" Padding="10,5" Margin="0,0,6,6"
                                IsEnabled="{Binding Downloads.MushafRunning, Converter={x:Static c:Not.Instance}}"/>
                        <Button Content="إيقاف" Command="{Binding CancelMushafDownloadCommand}" Padding="10,5" Margin="0,0,6,6"
                                Visibility="{Binding Downloads.MushafRunning, Converter={StaticResource BoolVis}}"/>
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Muted}" FontSize="11.5" TextWrapping="Wrap" Margin="0,6,0,0"
                               Text="يستمر التنزيل إذا أغلقت النافذة (البرنامج يبقى بجوار الساعة)، ويظهر تقدّمه على أيقونة شريط المهام، ثم يصلك إشعار عند انتهائه."/>
                </StackPanel>
            </Border>
        </Popup>
        <TextBlock Text="{Binding Downloads.QuranText}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="14,0" TextTrimming="CharacterEllipsis"
                   Visibility="{Binding Downloads.QuranRunning, Converter={StaticResource BoolVis}}"/>
    </DockPanel>
    <Grid>
    <v:MushafView DataContext="{Binding Mushaf}" Visibility="{Binding DataContext.IsMushaf, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolVis}}"/>
    <Grid Visibility="{Binding IsText, Converter={StaticResource BoolVis}}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== Index: surahs / bookmarks / search ===== -->
        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="10" Margin="0">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="2,2,2,8">
                    <TextBox x:Name="FilterBox" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged, Delay=250}" Padding="34,7,10,7"/>
                    <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False"/>
                    <TextBlock Text="ابحث عن سورة أو كلمة في الآيات" Foreground="{DynamicResource TextMutedBrush}" IsHitTestVisible="False"
                               VerticalAlignment="Center" Margin="36,0,0,0" FontSize="12.5"
                               Visibility="{Binding Text, ElementName=FilterBox, Converter={StaticResource Empty}}"/>
                </Grid>
                <ListBox x:Name="IndexList" ItemsSource="{Binding Index}" VirtualizingPanel.IsVirtualizing="True"
                         ScrollViewer.CanContentScroll="True" SelectionChanged="IndexList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{DynamicResource GoldBrush}" Margin="0,6,0,2"
                                           Visibility="{Binding IsHeader, Converter={StaticResource BoolVis}}"/>
                                <DockPanel Visibility="{Binding IsHeader, Converter={StaticResource BoolVis}, ConverterParameter=inv}">
                                    <Border DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="17" BorderThickness="1.5"
                                            BorderBrush="{DynamicResource GoldBrush}" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="Badge" Text="{Binding Badge}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   FontWeight="Bold" FontSize="12.5"/>
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontSize="14.5" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DockPanel>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Kind}" Value="hit">
                                    <Setter TargetName="Badge" Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="bookmark">
                                    <Setter TargetName="Badge" Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
                                    <Setter TargetName="Badge" Property="Foreground" Value="{DynamicResource GoldBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="continue">
                                    <Setter TargetName="Badge" Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
                                    <Setter TargetName="Badge" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ===== Reader ===== -->
        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0" Margin="0">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="18,14,18,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource GhostButton}" Command="{Binding PrevSurahCommand}" ToolTip="السورة السابقة">
                        <TextBlock Text="&#xE76C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"/>
                    </Button>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding SurahTitle}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding SurahInfo}" FontSize="12.5" Foreground="{DynamicResource GoldBrush}" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Style="{StaticResource GhostButton}" Command="{Binding FontDownCommand}" ToolTip="تصغير الخط" Content="أ-" FontSize="13"/>
                        <Button Style="{StaticResource GhostButton}" Command="{Binding FontUpCommand}" ToolTip="تكبير الخط" Content="أ+" FontSize="15"/>
                        <Button Style="{StaticResource GhostButton}" Command="{Binding NextSurahCommand}" ToolTip="السورة التالية">
                            <TextBlock Text="&#xE76B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <Border DockPanel.Dock="Top" Margin="18,0,18,8" Padding="10,6" CornerRadius="10" Background="{DynamicResource Surface2Brush}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="&#xE720;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" VerticalAlignment="Center"
                                   Foreground="{DynamicResource GoldBrush}" Margin="0,0,8,0"/>
                        <TextBlock DockPanel.Dock="Left" Text="القارئ" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding PlayPauseCommand}" Margin="8,0,0,0" Padding="14,5">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding PlayGlyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,2,6,0"/>
                                    <TextBlock Text="{Binding PlayLabel}"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding StopRecitationCommand}" Margin="6,0,0,0" Padding="10,5" ToolTip="إيقاف"
                                    Visibility="{Binding IsReciting, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="&#xE71A;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"/>
                            </Button>
                        </StackPanel>
                        <ComboBox ItemsSource="{Binding ReciterList}" DisplayMemberPath="Name" SelectedValuePath="Id"
                                  SelectedValue="{Binding ReciterId}" MaxDropDownHeight="380"/>
                    </DockPanel>
                </Border>

                <TextBlock DockPanel.Dock="Bottom" Text="اضغط بزر الفأرة الأيمن على أي آية للاستماع منها، أو لحفظ موضع القراءة، أو لإضافة علامة، أو للنسخ. يُحفظ صوت كل آية بعد سماعها لتعمل دون إنترنت."
                           Style="{StaticResource Muted}" FontSize="11.5" Margin="18,4,18,10"/>
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Foreground="{DynamicResource AccentBrush}" Margin="18,0"
                           Visibility="{Binding Status, Converter={StaticResource NotEmpty}}"/>

                <Border DockPanel.Dock="Top" Margin="18,0,18,6" Visibility="{Binding ShowBasmala, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="{Binding BasmalaText}" FontFamily="{StaticResource QuranFont}" FontSize="{Binding FontSize}"
                               HorizontalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                </Border>

                <ListBox x:Name="AyahList" ItemsSource="{Binding Ayahs}" Margin="10,0,10,4" HorizontalContentAlignment="Stretch"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel"
                         MouseDoubleClick="AyahList_MouseDoubleClick">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <!-- ContextMenu is outside the visual tree: pass the view model through Tag -->
                            <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}"/>
                            <Setter Property="ContextMenu">
                                <Setter.Value>
                                    <ContextMenu>
                                        <MenuItem Header="استماع من هذه الآية"
                                                  Command="{Binding PlacementTarget.Tag.PlayFromAyahCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                        <Separator/>
                                        <MenuItem Header="حفظ موضع القراءة هنا"
                                                  Command="{Binding PlacementTarget.Tag.SaveLastReadCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                        <MenuItem Header="إزالة موضع القراءة"
                                                  Command="{Binding PlacementTarget.Tag.ClearLastReadCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        <MenuItem Header="إضافة / إزالة علامة"
                                                  Command="{Binding PlacementTarget.Tag.ToggleBookmarkCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                        <MenuItem Header="نسخ الآية"
                                                  Command="{Binding PlacementTarget.Tag.CopyAyahCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                    </ContextMenu>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Bg" CornerRadius="8" Padding="6,2" BorderThickness="0">
                                <TextBlock TextWrapping="Wrap" TextAlignment="Justify" FlowDirection="RightToLeft"
                                           FontFamily="{StaticResource QuranFont}" Foreground="{DynamicResource TextBrush}"
                                           FontSize="{Binding DataContext.FontSize, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                           LineStackingStrategy="BlockLineHeight"
                                           LineHeight="{Binding DataContext.FontSize, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={x:Static c:Scale.ByTwo}}">
                                    <Run Text="{Binding Text, Mode=OneWay}"/>
                                    <Run Text="{Binding Mark, Mode=OneWay}" Foreground="{DynamicResource GoldBrush}"/>
                                </TextBlock>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsBookmarked}" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource GoldSoftBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                    <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                    <Setter TargetName="Bg" Property="BorderThickness" Value="1"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsLastRead}" Value="True">
                                    <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                    <Setter TargetName="Bg" Property="BorderThickness" Value="2,0,0,0"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
    </Grid>
    </Grid>
    </DockPanel>
</UserControl>
