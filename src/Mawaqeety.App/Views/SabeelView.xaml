<UserControl x:Class="Mawaqeety.App.Views.SabeelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Mawaqeety.App.Controls">
    <UserControl.Resources>
        <c:BoolToVisibilityConverter x:Key="BoolVis"/>
        <c:EmptyToVisibilityConverter x:Key="Empty"/>
        <c:NotEmptyToVisibilityConverter x:Key="NotEmpty"/>
        <Style x:Key="Note" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <!-- An entry «من محتوى التطبيق»: section chip, title, quote and source; the button opens it in its page. -->
        <DataTemplate x:Key="LibraryCard">
            <Border Style="{StaticResource Card}" Padding="18,12" Margin="0,0,0,10">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="10,3"
                                Command="{Binding DataContext.OpenEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding OpenLabel}"/>
                                <TextBlock Text="&#xE76B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="6,3,0,0" FontSize="11"/>
                            </StackPanel>
                        </Button>
                        <Border CornerRadius="8" Background="{DynamicResource AccentSoftBrush}" Padding="10,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Section}" FontSize="12" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/>
                        </Border>
                    </DockPanel>
                    <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <TextBlock Text="{Binding Snippet}" FontSize="14" LineHeight="26" TextWrapping="Wrap" Margin="0,4,0,0"
                               Visibility="{Binding HasSnippet, Converter={StaticResource BoolVis}}"/>
                    <TextBlock Text="{Binding Source}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                               Visibility="{Binding HasSource, Converter={StaticResource BoolVis}}"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,24" MaxWidth="980">
            <!-- Hero: the question box -->
            <Border Style="{StaticResource HeroCard}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8BD;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="26" Foreground="#E9C75A" VerticalAlignment="Center" Margin="0,4,14,0"/>
                        <StackPanel>
                            <TextBlock Text="اسأل سبيل" Foreground="White" FontSize="26" FontWeight="Bold"/>
                            <TextBlock Text="اسأل عن آية أو حديث أو مسألة أو غزوة… — بلا إنترنت، من المصادر ومن محتوى التطبيق" Foreground="{DynamicResource HeroMutedBrush}" FontSize="13.5"/>
                        </StackPanel>
                    </StackPanel>
                    <DockPanel Margin="0,16,0,0">
                        <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" Padding="18,8"
                                Command="{Binding AskCommand}" CommandParameter="{Binding Text, ElementName=QueryBox}" IsDefault="True">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,2,8,0"/>
                                <TextBlock Text="ابحث"/>
                            </StackPanel>
                        </Button>
                        <Grid>
                            <TextBox x:Name="QueryBox" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" FontSize="15" Padding="12,8"/>
                            <TextBlock Text="مثال: تفسير آية الكرسي، غزوة بدر، نصاب الزكاة" Foreground="{DynamicResource TextMutedBrush}" IsHitTestVisible="False"
                                       VerticalAlignment="Center" Margin="14,0" FontSize="14"
                                       Visibility="{Binding Text, ElementName=QueryBox, Converter={StaticResource Empty}}"/>
                        </Grid>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Examples}" Margin="0,12,0,0">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding}" Padding="12,3" Margin="0,0,8,6" FontSize="12.5" Background="#26FFFFFF" Foreground="White" BorderBrush="#40FFFFFF"
                                        Command="{Binding DataContext.AskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <TextBlock Text="جارٍ البحث في المصحف والتفسير والصحيحين…" Style="{StaticResource Muted}" FontSize="14" HorizontalAlignment="Center" Margin="0,20"
                       Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}"/>

            <!-- How to ask -->
            <Border Style="{StaticResource Card}" Visibility="{Binding ShowIntro, Converter={StaticResource BoolVis}}">
                <StackPanel>
                    <TextBlock Text="كيف تسأل سبيل؟" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource GoldBrush}" Margin="0,0,0,8"/>
                    <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="28"
                               Text="• تفسير آية: اكتب اسمها (آية الكرسي) أو السورة ورقم الآية (الكهف 10).&#x0a;• موضوع: اكتب كلمة أو أكثر (الصبر، بر الوالدين) فتظهر الآيات وتفسيرها والأحاديث.&#x0a;• حديث: اكتب جزءًا من نصه (إنما الأعمال بالنيات).&#x0a;• من محتوى التطبيق: مسألة فقهية (المسح على الجوارب)، غزوة (غزوة بدر)، صحابي (كيف أسلم أبو بكر)، نبي، دعاء، أو صفحة (حاسبة الزكاة) فتفتحها من النتيجة.&#x0a;يعمل بلا إنترنت، وينقل النصوص من مصادرها كما هي."/>
                </StackPanel>
            </Border>

            <!-- The answer -->
            <StackPanel Visibility="{Binding HasAnswer, Converter={StaticResource BoolVis}}">
                <Border Style="{StaticResource Note}" Visibility="{Binding Ruling, Converter={StaticResource BoolVis}}" BorderBrush="{DynamicResource GoldBrush}">
                    <DockPanel>
                        <TextBlock Text="&#xE7BA;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" Foreground="{DynamicResource GoldBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock TextWrapping="Wrap" LineHeight="24" Text="سؤالك عن حكم شرعي: هذه نصوص ونقول من فتاوى منشورة بمصادرها للاطلاع فقط، وليست فتوى لحالك. اسأل أهل العلم أو دار الإفتاء في بلدك."/>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Note}" Visibility="{Binding IsEmpty, Converter={StaticResource BoolVis}}">
                    <DockPanel>
                        <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" Foreground="{DynamicResource GoldBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock TextWrapping="Wrap" LineHeight="24" Text="لم أجد نتيجة. جرّب كلمة من الآية أو الحديث، أو اسم السورة ورقم الآية (مثل: البقرة 255)."/>
                    </DockPanel>
                </Border>
                <DockPanel Margin="4,4,4,12">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Copied}" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Title}" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource GoldBrush}" TextWrapping="Wrap"
                               Visibility="{Binding Title, Converter={StaticResource NotEmpty}}"/>
                </DockPanel>

                <TextBlock Text="📚 من محتوى التطبيق" Style="{StaticResource Section}" Margin="4,0,4,10"
                           Visibility="{Binding LibraryBefore.Count, Converter={x:Static c:ZeroVisibility.Instance}, ConverterParameter=inv}"/>
                <ItemsControl ItemsSource="{Binding LibraryBefore}" ItemTemplate="{StaticResource LibraryCard}"/>
                <Button Content="{Binding LibraryMoreText}" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Padding="12,4" Margin="0,0,0,10"
                        Command="{Binding MoreLibraryCommand}" Visibility="{Binding ShowMoreBefore, Converter={StaticResource BoolVis}}"/>

                <TextBlock Text="📖 الآيات وتفسيرها (التفسير الميسر)" Style="{StaticResource Section}"
                           Visibility="{Binding Ayat.Count, Converter={x:Static c:ZeroVisibility.Instance}, ConverterParameter=inv}"/>
                <ItemsControl ItemsSource="{Binding Ayat}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="20,14" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontFamily="{StaticResource QuranFont}" FontSize="23" LineHeight="48"/>
                                    <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,8"/>
                                    <TextBlock Text="{Binding Tafsir}" TextWrapping="Wrap" FontSize="14.5" LineHeight="28"/>
                                    <DockPanel Margin="0,10,0,0">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="10,4" ToolTip="نسخ الآية وتفسيرها"
                                                Command="{Binding DataContext.CopyAyahCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE8C8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,2,6,0"/>
                                                <TextBlock Text="نسخ"/>
                                            </StackPanel>
                                        </Button>
                                        <Button DockPanel.Dock="Right" Padding="12,4" Margin="0,0,8,0"
                                                Command="{Binding DataContext.OpenInMushafCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE736;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,2,6,0"/>
                                                <TextBlock Text="افتح في المصحف"/>
                                            </StackPanel>
                                        </Button>
                                        <Border CornerRadius="8" Background="{DynamicResource AccentSoftBrush}" Padding="10,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Reference}" FontSize="12.5" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/>
                                        </Border>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="توجد نتائج أخرى؛ زِد كلمة لتضييق البحث." Style="{StaticResource Muted}" Margin="4,0,4,10"
                           Visibility="{Binding More, Converter={StaticResource BoolVis}}"/>

                <TextBlock Text="📜 من الأحاديث الصحيحة (البخاري ومسلم)" Style="{StaticResource Section}" Margin="4,8,4,10"
                           Visibility="{Binding Hadith.Count, Converter={x:Static c:ZeroVisibility.Instance}, ConverterParameter=inv}"/>
                <ItemsControl ItemsSource="{Binding Hadith}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontFamily="{StaticResource QuranFont}" FontSize="20" LineHeight="40"/>
                                    <DockPanel Margin="0,6,0,0">
                                        <Button DockPanel.Dock="Right" Content="نسخ" Padding="12,3" Style="{StaticResource GhostButton}"
                                                Command="{Binding DataContext.CopyHadithCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                        <Border CornerRadius="8" Background="{DynamicResource AccentSoftBrush}" Padding="8,2" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Reference}" FontSize="12" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/>
                                        </Border>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="📚 من محتوى التطبيق" Style="{StaticResource Section}" Margin="4,8,4,10"
                           Visibility="{Binding LibraryAfter.Count, Converter={x:Static c:ZeroVisibility.Instance}, ConverterParameter=inv}"/>
                <ItemsControl ItemsSource="{Binding LibraryAfter}" ItemTemplate="{StaticResource LibraryCard}"/>
                <Button Content="{Binding LibraryMoreText}" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Padding="12,4" Margin="0,0,0,10"
                        Command="{Binding MoreLibraryCommand}" Visibility="{Binding ShowMoreAfter, Converter={StaticResource BoolVis}}"/>
            </StackPanel>

            <TextBlock Text="{Binding DisclaimerText}" Style="{StaticResource Muted}" FontSize="12" LineHeight="22" Margin="4,8,4,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
