<UserControl x:Class="Mawaqeety.App.Views.MushafView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Mawaqeety.App.Controls"
             xmlns:v="clr-namespace:Mawaqeety.App.Views"
             xmlns:vm="clr-namespace:Mawaqeety.App.ViewModels"
             Focusable="True" FocusVisualStyle="{x:Null}">
    <UserControl.Resources>
        <c:BoolToVisibilityConverter x:Key="BoolVis"/>
        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>

        <DataTemplate DataType="{x:Type vm:MushafPageVm}">
            <DockPanel Margin="8,4">
                <DockPanel DockPanel.Dock="Top" Margin="8,0,8,2" TextElement.FontSize="12.5" TextElement.FontWeight="SemiBold"
                           TextElement.Foreground="{Binding DataContext.Tone.MutedBrush, RelativeSource={RelativeSource AncestorType=v:MushafView}}">
                    <TextBlock DockPanel.Dock="Left" Text="{Binding SurahText}"/>
                    <TextBlock Text="{Binding JuzText}" HorizontalAlignment="Right"/>
                </DockPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding NumberText}" HorizontalAlignment="Center" FontSize="13" Margin="0,2,0,0"
                           Foreground="{Binding DataContext.Tone.MutedBrush, RelativeSource={RelativeSource AncestorType=v:MushafView}}"/>
                <Viewbox Stretch="Uniform" Height="{Binding PageHeight, RelativeSource={RelativeSource AncestorType=v:MushafView}}">
                    <Grid Width="1440" Height="2330" FlowDirection="LeftToRight" Background="Transparent" Tag="{Binding}"
                          MouseRightButtonUp="Page_MouseRightButtonUp">
                        <Image Source="{Binding Image}" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <ItemsControl ItemsSource="{Binding Highlights}" IsHitTestVisible="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                    <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="{Binding W}" Height="{Binding H}" CornerRadius="22"
                                            Background="{Binding DataContext.Tone.HighlightBrush, RelativeSource={RelativeSource AncestorType=v:MushafView}}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <!-- reading-position ribbon -->
                        <Path HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,40,0" Fill="{DynamicResource AccentBrush}"
                              Data="M0,0 L60,0 L60,110 L30,85 L0,110 Z" Visibility="{Binding Ribbon, Converter={StaticResource BoolVis}}"/>
                        <TextBlock Text="جارٍ تحميل الصفحة…" FontSize="60" HorizontalAlignment="Center" VerticalAlignment="Center" FlowDirection="RightToLeft"
                                   Foreground="{Binding DataContext.Tone.MutedBrush, RelativeSource={RelativeSource AncestorType=v:MushafView}}"
                                   Visibility="{Binding Loading, Converter={StaticResource BoolVis}}"/>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" FlowDirection="RightToLeft"
                                    Visibility="{Binding Failed, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="تعذّر تحميل الصفحة. تأكد من الاتصال بالإنترنت." FontSize="56" TextWrapping="Wrap" TextAlignment="Center" Width="1100"
                                       Foreground="{Binding DataContext.Tone.FgBrush, RelativeSource={RelativeSource AncestorType=v:MushafView}}"/>
                            <Button Content="إعادة المحاولة" FontSize="48" Padding="40,10" Margin="0,30,0,0" HorizontalAlignment="Center"
                                    Command="{Binding DataContext.RetryCommand, RelativeSource={RelativeSource AncestorType=v:MushafView}}" CommandParameter="{Binding}"/>
                        </StackPanel>
                    </Grid>
                </Viewbox>
            </DockPanel>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <!-- ===== Toolbar ===== -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="10,6" Margin="0,0,0,10">
            <WrapPanel VerticalAlignment="Center">
                <Button Style="{StaticResource GhostButton}" Command="{Binding PrevPageCommand}" ToolTip="الصفحة السابقة (السهم الأيمن)">
                    <TextBlock Text="&#xE76B;" Style="{StaticResource Glyph}"/>
                </Button>
                <TextBlock Text="{Binding PageText}" FontWeight="Bold" VerticalAlignment="Center" MinWidth="64" TextAlignment="Center"/>
                <Button Style="{StaticResource GhostButton}" Command="{Binding NextPageCommand}" ToolTip="الصفحة التالية (السهم الأيسر)">
                    <TextBlock Text="&#xE76C;" Style="{StaticResource Glyph}"/>
                </Button>
                <ComboBox Width="170" Margin="8,0,0,0" ItemsSource="{Binding SurahList}" DisplayMemberPath="Name" SelectedValuePath="Number"
                          SelectedValue="{Binding SelectedSurah}" MaxDropDownHeight="420" ToolTip="السورة"/>
                <ComboBox Width="112" Margin="6,0,0,0" ItemsSource="{Binding JuzList}" DisplayMemberPath="Name" SelectedValuePath="Number"
                          SelectedValue="{Binding SelectedJuz}" MaxDropDownHeight="420" ToolTip="الجزء"/>
                <TextBox Width="58" Margin="6,0,0,0" Text="{Binding PageInput, UpdateSourceTrigger=PropertyChanged}" ToolTip="اكتب رقم الصفحة ثم Enter"
                         TextAlignment="Center">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding GoToInputCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
                <Border Width="1" Height="24" Background="{DynamicResource LineBrush}" Margin="10,0"/>
                <Button Style="{StaticResource GhostButton}" Command="{Binding ToggleReadHereCommand}" ToolTip="حفظ موضع القراءة هنا / إزالته">
                    <TextBlock x:Name="ReadGlyph" Text="&#xE8A4;" Style="{StaticResource Glyph}"/>
                </Button>
                <ComboBox Width="190" Margin="4,0,0,0" ItemsSource="{Binding Quran.ReciterList}" DisplayMemberPath="Name" SelectedValuePath="Id"
                          SelectedValue="{Binding Quran.ReciterId}" MaxDropDownHeight="380" ToolTip="القارئ"/>
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding PlayPageCommand}" Margin="6,0,0,0" Padding="12,5" ToolTip="استماع من أول الصفحة">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Quran.PlayGlyph}" Style="{StaticResource Glyph}" Margin="0,2,6,0"/>
                        <TextBlock Text="{Binding Quran.PlayLabel}"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding Quran.StopRecitationCommand}" Margin="4,0,0,0" Padding="9,5" ToolTip="إيقاف"
                        Visibility="{Binding Quran.IsReciting, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="&#xE71A;" Style="{StaticResource Glyph}"/>
                </Button>
                <ToggleButton x:Name="LookButton" Margin="8,0,0,0" Padding="10,5" ToolTip="ألوان المصحف والسطوع والتكبير">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE793;" Style="{StaticResource Glyph}" Margin="0,2,6,0"/>
                        <TextBlock Text="المظهر"/>
                    </StackPanel>
                </ToggleButton>
                <Popup IsOpen="{Binding IsChecked, ElementName=LookButton}" PlacementTarget="{Binding ElementName=LookButton}" StaysOpen="False"
                       Placement="Bottom" AllowsTransparency="True" Closed="LookPopup_Closed">
                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="14"
                            Padding="16" Width="330" Margin="6">
                        <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.35"/></Border.Effect>
                        <StackPanel>
                            <TextBlock Text="ألوان المصحف" FontWeight="Bold" Margin="0,0,0,8"/>
                            <ItemsControl ItemsSource="{Binding Tones}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <RadioButton GroupName="tone" Margin="0,3" Cursor="Hand"
                                                     Command="{Binding DataContext.SelectToneCommand, RelativeSource={RelativeSource AncestorType=v:MushafView}}"
                                                     CommandParameter="{Binding Id}">
                                            <RadioButton.IsChecked>
                                                <MultiBinding Converter="{x:Static c:Equal.Instance}" Mode="OneWay">
                                                    <Binding Path="Id"/>
                                                    <Binding Path="DataContext.ToneId" RelativeSource="{RelativeSource AncestorType=v:MushafView}"/>
                                                </MultiBinding>
                                            </RadioButton.IsChecked>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="34" Height="24" CornerRadius="6" Background="{Binding Bg}" Margin="0,0,10,0" BorderBrush="#55888888" BorderThickness="1">
                                                    <TextBlock Text="بسم" FontFamily="{StaticResource QuranFont}" Foreground="{Binding Fg}" FontSize="12"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </RadioButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="سطوع الصفحة (لا يغيّر سطوع الشاشة)" FontWeight="Bold" Margin="0,12,0,4"/>
                            <Slider Minimum="0.4" Maximum="1" Value="{Binding Brightness}" SmallChange="0.05" LargeChange="0.1"/>
                            <TextBlock Text="التكبير" FontWeight="Bold" Margin="0,12,0,4"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="−" Width="40" Command="{Binding ZoomOutCommand}"/>
                                <Button Content="ملء الشاشة" Margin="6,0" Padding="10,4" Command="{Binding ZoomResetCommand}"/>
                                <Button Content="+" Width="40" Command="{Binding ZoomInCommand}"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Muted}" FontSize="11.5" Margin="0,10,0,0" TextWrapping="Wrap"
                                       Text="للتنقل: الأسهم أو عجلة الماوس. للتكبير: Ctrl مع العجلة. كليك يمين على أي آية: الاستماع منها، أو حفظ موضعها، أو وضع علامة."/>
                        </StackPanel>
                    </Border>
                </Popup>
            </WrapPanel>
        </Border>

        <!-- ===== Pages ===== -->
        <Border x:Name="Stage" CornerRadius="14" Background="{Binding Tone.BgBrush}" ClipToBounds="True"
                SizeChanged="Stage_SizeChanged" PreviewMouseWheel="Stage_PreviewMouseWheel">
            <Grid>
                <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ContentControl Content="{Binding Right}" Focusable="False"/>
                        <Rectangle Width="2" Margin="0,30" Visibility="{Binding Left, Converter={x:Static c:NotNullVisibility.Instance}}">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00000000" Offset="0"/>
                                    <GradientStop Color="#66000000" Offset="0.5"/>
                                    <GradientStop Color="#00000000" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <ContentControl Content="{Binding Left}" Focusable="False"/>
                    </StackPanel>
                </ScrollViewer>
                <Rectangle Fill="Black" Opacity="{Binding Dim}" IsHitTestVisible="False"/>
            </Grid>
        </Border>
    </DockPanel>
</UserControl>
