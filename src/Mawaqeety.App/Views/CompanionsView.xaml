<UserControl x:Class="Mawaqeety.App.Views.CompanionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24,24,24,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <DockPanel>
            <Border DockPanel.Dock="Top" Background="{DynamicResource HeroBrush}" Effect="{StaticResource HeroShadow}" BorderBrush="{StaticResource RimBrush}"
                    BorderThickness="0,1,0,0" CornerRadius="18" Padding="16,12" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{Binding Book.Intro}" Foreground="White" TextWrapping="Wrap" FontFamily="{StaticResource QuranFont}" FontSize="15" LineHeight="28"/>
                    <TextBlock Text="{Binding Book.IntroSource}" Foreground="{DynamicResource HeroMutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <ListBox ItemsSource="{Binding List}" SelectedItem="{Binding Selected}" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="4,5">
                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="15"/>
                            <TextBlock Text="{Binding Title}" Style="{StaticResource Muted}" FontSize="12"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="900" DataContext="{Binding Selected}">
                <Border Background="{DynamicResource HeroBrush}" Effect="{StaticResource HeroShadow}" BorderBrush="{StaticResource RimBrush}"
                        BorderThickness="0,1,0,0" CornerRadius="20" Padding="24,18" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Foreground="White" FontSize="28" FontWeight="Bold">
                            <Run Text="{Binding Name, Mode=OneWay}"/><Run Text=" رضي الله عنه"/>
                        </TextBlock>
                        <TextBlock Text="{Binding Title}" Foreground="#E9C75A" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Bio}" Foreground="{DynamicResource HeroMutedBrush}" TextWrapping="Wrap" LineHeight="28" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
                <ItemsControl ItemsSource="{Binding Situations}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" Foreground="{DynamicResource GoldBrush}" FontWeight="Bold" FontSize="16"/>
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="15.5" LineHeight="30" Margin="0,6,0,0"/>
                                    <Border CornerRadius="8" Background="#2912A372" Padding="8,2" HorizontalAlignment="Left" Margin="0,8,0,0">
                                        <TextBlock Text="{Binding Source}" FontSize="12" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="المواقف مختارة من صحيح البخاري وصحيح مسلم، مع رقم كل حديث." Style="{StaticResource Muted}" HorizontalAlignment="Center"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
