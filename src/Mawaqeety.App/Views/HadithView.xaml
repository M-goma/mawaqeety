<UserControl x:Class="Mawaqeety.App.Views.HadithView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Mawaqeety.App.Controls">
    <UserControl.Resources>
        <c:BoolToVisibilityConverter x:Key="BoolVis"/>
        <DataTemplate x:Key="HadithCard">
            <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontFamily="{StaticResource QuranFont}" FontSize="20" LineHeight="40"/>
                    <DockPanel Margin="0,6,0,0">
                        <Button DockPanel.Dock="Right" Content="نسخ" Padding="12,3" Style="{StaticResource GhostButton}"
                                Command="{Binding DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                        <Border CornerRadius="8" Background="#2912A372" Padding="8,2" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding Reference}" FontSize="12" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/>
                        </Border>
                    </DockPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <Grid Margin="24,24,24,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Collections and books -->
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                <RadioButton Style="{StaticResource Segment}" Content="صحيح البخاري" GroupName="col" IsChecked="{Binding IsBukhari, Mode=OneWay}" Command="{Binding ShowBukhariCommand}"/>
                <RadioButton Style="{StaticResource Segment}" Content="صحيح مسلم" GroupName="col" Margin="6,0,0,0"
                             IsChecked="{Binding IsBukhari, Mode=OneWay, Converter={x:Static c:Not.Instance}}" Command="{Binding ShowMuslimCommand}"/>
            </StackPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <Button DockPanel.Dock="Right" Content="بحث" Command="{Binding SearchCommand}" Margin="6,0,0,0" IsDefault="True"/>
                <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" ToolTip="اكتب كلمة أو أكثر"/>
            </DockPanel>
            <ListBox ItemsSource="{Binding Books}" SelectedItem="{Binding Book}" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="2,4">
                            <Border DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="10" Background="{DynamicResource HeroBrush}"
                                    Effect="{StaticResource RaisedShadow}" BorderBrush="{StaticResource RimBrush}" BorderThickness="0,1,0,0" Margin="0,0,10,0">
                                <TextBlock Text="{Binding NumberText}" Foreground="#E9C75A" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding CountText}" Style="{StaticResource Muted}" FontSize="12"/>
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Hadiths -->
        <DockPanel Grid.Column="2">
            <Border DockPanel.Dock="Top" Background="{DynamicResource HeroBrush}" Effect="{StaticResource HeroShadow}" BorderBrush="{StaticResource RimBrush}"
                    BorderThickness="0,1,0,0" CornerRadius="18" Padding="22,14" Margin="0,0,0,14">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton Style="{StaticResource Segment}" Content="نص الحديث" GroupName="full" Foreground="White"
                                     IsChecked="{Binding ShowFull, Mode=OneWay, Converter={x:Static c:Not.Instance}}" Click="TextOnly_Click"/>
                        <RadioButton Style="{StaticResource Segment}" Content="بالسند" GroupName="full" Foreground="White" Margin="6,0,0,0"
                                     IsChecked="{Binding ShowFull, Mode=OneWay}" Click="Full_Click"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" Foreground="White" FontSize="24" FontWeight="Bold"/>
                        <TextBlock Text="{Binding Status}" Foreground="{DynamicResource HeroMutedBrush}"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <StackPanel DockPanel.Dock="Top" MaxWidth="900" Visibility="{Binding Items.Count, Converter={x:Static c:ZeroVisibility.Instance}}">
                <TextBlock Text="{Binding TodayTitle}" Foreground="{DynamicResource GoldBrush}" FontWeight="Bold" FontSize="16" Margin="0,0,0,8"/>
                <ContentControl Content="{Binding Today}" ContentTemplate="{StaticResource HadithCard}"/>
                <TextBlock Text="الصحيحان أصحّ كتب الحديث باتفاق العلماء. النص العربي الكامل بأرقام الأحاديث المعتمدة." Style="{StaticResource Muted}" Margin="4,0"/>
            </StackPanel>
            <!-- Virtualized: a book can hold hundreds of hadiths -->
            <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource HadithCard}"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><VirtualizingStackPanel MaxWidth="900"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="True" Padding="0,0,8,0">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
            </ItemsControl>
        </DockPanel>
    </Grid>
</UserControl>
