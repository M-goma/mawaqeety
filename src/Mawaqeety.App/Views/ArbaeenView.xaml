<UserControl x:Class="Mawaqeety.App.Views.ArbaeenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Mawaqeety.App.Controls">
    <UserControl.Resources>
        <c:BoolToVisibilityConverter x:Key="BoolVis"/>
        <c:NotEmptyToVisibilityConverter x:Key="NotEmpty"/>
    </UserControl.Resources>

    <Grid Margin="24,24,24,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- The book and the list of the 42 hadiths -->
        <DockPanel>
            <Border DockPanel.Dock="Top" Background="{DynamicResource HeroBrush}" Effect="{StaticResource HeroShadow}" BorderBrush="{StaticResource RimBrush}"
                    BorderThickness="0,1,0,0" CornerRadius="18" Padding="16,12" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{Binding Book.Title}" Foreground="White" FontSize="22" FontWeight="Bold"/>
                    <TextBlock Text="{Binding Book.Author}" Foreground="#E9C75A" FontSize="12" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding AboutText}" Foreground="White" TextWrapping="Wrap" FontFamily="{StaticResource QuranFont}" FontSize="14" LineHeight="27" Margin="0,8,0,0"/>
                    <TextBlock Text="{Binding AboutSourceText}" Foreground="{DynamicResource HeroMutedBrush}" FontSize="11.5"/>
                    <TextBlock Text="اثنان وأربعون حديثًا جمعها النووي (ت ٦٧٦هـ)، وجرى عليها اسم «الأربعين» تغليبًا." Foreground="{DynamicResource HeroMutedBrush}"
                               FontSize="11.5" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    <DockPanel Margin="0,10,0,4">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding MemorizedPercent}" Foreground="{DynamicResource HeroMutedBrush}" FontSize="12"/>
                        <TextBlock Text="{Binding MemorizedText}" Foreground="White" FontWeight="Bold"/>
                    </DockPanel>
                    <ProgressBar Style="{StaticResource HeroProgress}" Value="{Binding MemorizedProgress, Mode=OneWay}" Maximum="100"/>
                </StackPanel>
            </Border>
            <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="2,4">
                            <Border x:Name="Num" DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="10" Background="{DynamicResource HeroBrush}"
                                    Effect="{StaticResource RaisedShadow}" BorderBrush="{StaticResource RimBrush}" BorderThickness="0,1,0,0" Margin="0,0,10,0">
                                <TextBlock Text="{Binding NumberText}" Foreground="#E9C75A" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock DockPanel.Dock="Right" Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                                       Foreground="{DynamicResource GoldBrush}" VerticalAlignment="Center" Margin="6,0,2,0" ToolTip="حفظته"
                                       Visibility="{Binding IsMemorized, Converter={StaticResource BoolVis}}"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding H.Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding H.Narrator}" Style="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- One hadith -->
        <ScrollViewer x:Name="Scroll" Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="900" Margin="0,0,8,24">
                <Border Background="{DynamicResource HeroBrush}" Effect="{StaticResource HeroShadow}" BorderBrush="{StaticResource RimBrush}"
                        BorderThickness="0,1,0,0" CornerRadius="18" Padding="22,16" Margin="0,0,0,16">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Command="{Binding PrevCommand}" Padding="10,6" Background="#26FFFFFF" Foreground="White" BorderBrush="#66FFFFFF" ToolTip="الحديث السابق">
                                <TextBlock Text="&#xE76C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"/>
                            </Button>
                            <Button Command="{Binding NextCommand}" Margin="6,0,0,0" Padding="10,6" Background="#26FFFFFF" Foreground="White" BorderBrush="#66FFFFFF" ToolTip="الحديث التالي">
                                <TextBlock Text="&#xE76B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"/>
                            </Button>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{Binding HeaderTitle}" Foreground="#E9C75A" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Selected.H.Title}" Foreground="White" FontSize="24" FontWeight="Bold" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Narrator}" Foreground="{DynamicResource HeroMutedBrush}" FontSize="13"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="20,16">
                    <StackPanel>
                        <TextBlock Text="{Binding Selected.H.Text}" TextWrapping="Wrap" TextAlignment="Justify" FontFamily="{StaticResource QuranFont}" FontSize="21"
                                   LineHeight="42" LineStackingStrategy="BlockLineHeight"/>
                        <Border CornerRadius="8" Background="#2912A372" Padding="10,4" HorizontalAlignment="Left" Margin="0,8,0,0">
                            <TextBlock Text="{Binding Selected.H.Takhrij}" FontSize="12.5" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        </Border>
                        <Border CornerRadius="8" Background="{DynamicResource GoldSoftBrush}" Padding="10,4" HorizontalAlignment="Left" Margin="0,6,0,0"
                                Visibility="{Binding HasGrade, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="{Binding Grade}" FontSize="12.5" Foreground="{DynamicResource GoldBrush}" FontWeight="SemiBold"/>
                        </Border>
                        <StackPanel Visibility="{Binding HasExtra, Converter={StaticResource BoolVis}}" Margin="0,12,0,0">
                            <TextBlock Text="{Binding Extra.Label}" Foreground="{DynamicResource GoldBrush}" FontWeight="Bold"/>
                            <TextBlock Text="{Binding Extra.Text}" TextWrapping="Wrap" FontFamily="{StaticResource QuranFont}" FontSize="19" LineHeight="38"/>
                            <Border CornerRadius="8" Background="#2912A372" Padding="10,4" HorizontalAlignment="Left" Margin="0,4,0,0"
                                    Visibility="{Binding HasExtraTakhrij, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="{Binding Extra.Takhrij}" FontSize="12.5" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Visibility="{Binding HasNote, Converter={StaticResource BoolVis}}" Margin="0,12,0,0">
                            <TextBlock Text="قال النووي" Foreground="{DynamicResource GoldBrush}" FontWeight="Bold" FontSize="13"/>
                            <TextBlock Text="{Binding Note}" TextWrapping="Wrap" FontSize="14.5" LineHeight="27"/>
                        </StackPanel>
                        <DockPanel Margin="0,12,0,0">
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding CopyCommand}" ToolTip="نسخ الحديث">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8C8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,2,6,0"/>
                                    <TextBlock Text="نسخ"/>
                                </StackPanel>
                            </Button>
                            <CheckBox IsChecked="{Binding Selected.IsMemorized}" Content="حفظت هذا الحديث" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="20,14" Visibility="{Binding HasIsnadNote, Converter={StaticResource BoolVis}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource GoldBrush}" Margin="0,3,8,0"/>
                            <TextBlock Text="في إسناده كلام" Foreground="{DynamicResource GoldBrush}" FontWeight="Bold"/>
                        </StackPanel>
                        <TextBlock Text="{Binding IsnadNote}" TextWrapping="Wrap" FontSize="14.5" LineHeight="27" Margin="0,6,0,0"/>
                        <TextBlock Text="وحكم النووي عليه مذكور في تخريجه أعلاه؛ فهو مما اختلف فيه أهل الحديث." Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="20,14" Visibility="{Binding HasSahih, Converter={StaticResource BoolVis}}">
                    <StackPanel>
                        <TextBlock Text="{Binding SahihHeading}" Foreground="{DynamicResource GoldBrush}" FontWeight="Bold" Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding SahihLinks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,8">
                                        <ToggleButton IsChecked="{Binding IsOpen, Mode=OneWay}" Command="{Binding ToggleCommand}" HorizontalAlignment="Left" Padding="12,5">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE82D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,2,8,0"/>
                                                <TextBlock Text="{Binding Label}"/>
                                            </StackPanel>
                                        </ToggleButton>
                                        <Border Visibility="{Binding IsOpen, Converter={StaticResource BoolVis}}" Background="{DynamicResource Surface2Brush}"
                                                CornerRadius="10" Padding="14,10" Margin="0,8,0,0">
                                            <StackPanel>
                                                <TextBlock Text="جارٍ التحميل…" Style="{StaticResource Muted}" Visibility="{Binding Loading, Converter={StaticResource BoolVis}}"/>
                                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontFamily="{StaticResource QuranFont}" FontSize="18" LineHeight="36"/>
                                                <TextBlock Text="{Binding Reference}" FontSize="12" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"
                                                           Visibility="{Binding Reference, Converter={StaticResource NotEmpty}}"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource Muted}" FontSize="11.5"
                                   Text="بترقيم محمد فؤاد عبد الباقي لصحيح مسلم، والترقيم المشهور لصحيح البخاري؛ وقد يختلف اللفظ يسيرًا عن لفظ النووي."/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="20,14" Visibility="{Binding HasBenefits, Converter={StaticResource BoolVis}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="&#xEA80;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource GoldBrush}" Margin="0,4,8,0"/>
                            <TextBlock Text="من فوائد الحديث" Foreground="{DynamicResource GoldBrush}" FontWeight="Bold" FontSize="16"/>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Benefits}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,8">
                                        <Ellipse DockPanel.Dock="Left" Width="6" Height="6" Fill="{DynamicResource GoldBrush}" Margin="0,11,10,0" VerticalAlignment="Top"/>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="15" LineHeight="28"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Command="{Binding OpenBenefitsCommand}"
                                Foreground="{DynamicResource AccentBrush}" Visibility="{Binding HasBenefitsUrl, Converter={StaticResource BoolVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8A7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,2,6,0"/>
                                <TextBlock Text="ابن رجب، جامع العلوم والحكم — إسلام ويب"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource Muted}" FontSize="11.5" TextAlignment="Center" Margin="12,4,12,0"
                           Text="النص من نسخة مشكولة للأربعين (مستودع hadith-json)، قوبل كاملًا على طبعة دار المنهاج (نسخة OpenITI) وعلى ألفاظ الصحيحين المرفقة في التطبيق، وصُحّحت الفروق. الفوائد مقتبسة بنصها من «جامع العلوم والحكم» لابن رجب الحنبلي في المكتبة الإسلامية بموقع إسلام ويب، مع رابط كل حديث."/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
