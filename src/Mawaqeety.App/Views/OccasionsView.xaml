<UserControl x:Class="Mawaqeety.App.Views.OccasionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Mawaqeety.App.Controls">
    <UserControl.Resources>
        <c:BoolToVisibilityConverter x:Key="BoolVis"/>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,24" MaxWidth="980">
            <Border Style="{StaticResource HeroCard}">
                <DockPanel>
                    <TextBlock Text="🗓️" Style="{StaticResource HeroEmoji}"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding HeroTop}" Foreground="{DynamicResource HeroMutedBrush}" FontSize="15"/>
                        <TextBlock Text="{Binding HeroMain}" Foreground="White" FontSize="30" FontWeight="Bold"/>
                        <TextBlock Text="{Binding HeroSub}" Foreground="#E9C75A" FontSize="14"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Today is a sunnah fast day -->
            <Border Style="{StaticResource Card}" Padding="20,10" BorderBrush="{DynamicResource GoldBrush}"
                    Visibility="{Binding FastToday, Converter={x:Static c:NotNullVisibility.Instance}}">
                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding FastedToday}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🍽️" FontFamily="Segoe UI Emoji" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <StackPanel>
                            <TextBlock Text="{Binding FastToday}" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="هل صمت اليوم؟" Style="{StaticResource Muted}" FontSize="12.5"/>
                        </StackPanel>
                    </StackPanel>
                </CheckBox>
            </Border>

            <TextBlock Text="{Binding CountText}" Style="{StaticResource Section}"/>
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="16,8" Margin="0,0,0,10">
                            <Expander Foreground="{DynamicResource TextBrush}">
                                <Expander.Header>
                                    <DockPanel Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Expander}, Converter={x:Static c:Minus.By36}}">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding When}" Foreground="{DynamicResource GoldBrush}" FontWeight="Bold" FontSize="13.5" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Emoji}" FontFamily="Segoe UI Emoji" FontSize="20" VerticalAlignment="Center" Margin="4,0,12,0"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="15.5" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" FontSize="12.5"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Expander.Header>
                                <StackPanel Margin="40,8,8,6">
                                    <TextBlock Text="{Binding Note}" Style="{StaticResource QuoteText}" FontSize="18" Visibility="{Binding HasNote, Converter={StaticResource BoolVis}}"/>
                                    <TextBlock Text="{Binding Ref}" Style="{StaticResource Muted}" FontSize="12" Visibility="{Binding HasRef, Converter={StaticResource BoolVis}}"/>
                                </StackPanel>
                            </Expander>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Style="{StaticResource Card}" Padding="20,14" Margin="0,6,0,14">
                <DockPanel>
                    <TextBlock Text="📅" FontFamily="Segoe UI Emoji" FontSize="20" Margin="0,2,12,0" VerticalAlignment="Top"/>
                    <StackPanel>
                        <TextBlock Text="صيام الاثنين والخميس" FontSize="15.5" FontWeight="Bold"/>
                        <TextBlock Text="{Binding MonThuNote}" Style="{StaticResource QuoteText}" FontSize="17" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding MonThuRef}" Style="{StaticResource Muted}" FontSize="12"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <TextBlock Style="{StaticResource Muted}" FontSize="12" LineHeight="22" Margin="4,0"
                       Text="التواريخ بالحساب الفلكي، وقد تختلف يومًا عن رؤية الهلال في بلدك؛ يمكنك ضبطها من الإعدادات (تعديل التاريخ الهجري)."/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
