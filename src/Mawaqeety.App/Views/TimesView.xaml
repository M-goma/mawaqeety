<UserControl x:Class="Mawaqeety.App.Views.TimesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Mawaqeety.App.Localization"
             xmlns:c="clr-namespace:Mawaqeety.App.Controls">
    <UserControl.Resources>
        <c:BoolToVisibilityConverter x:Key="BoolVis"/>
    </UserControl.Resources>
    <!-- Prayer times on their own; shares the home page's view model (DataContext = Dash). -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" DataContext="{Binding Dash}">
        <StackPanel Margin="32,28,32,24" MaxWidth="980">
            <DockPanel Margin="4,0,4,14">
                <TextBlock DockPanel.Dock="Right" Text="{Binding Clock}" FontSize="26" FontWeight="SemiBold" FlowDirection="LeftToRight" VerticalAlignment="Center"/>
                <StackPanel>
                    <TextBlock Text="مواقيت الصلاة" FontSize="26" FontWeight="Bold"/>
                    <TextBlock Style="{StaticResource Muted}">
                        <Run Text="{Binding CityName, Mode=OneWay}"/><Run Text="  •  "/><Run Text="{Binding GregorianDate, Mode=OneWay}"/><Run Text="  •  "/><Run Text="{Binding HijriDate, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </DockPanel>
            <!-- Today's table -->
            <Border Style="{StaticResource Card}" Padding="14,16">
                <StackPanel>
                    <TextBlock Text="{l:Tr TodayTimes}" Style="{StaticResource H2}" Margin="8,0,8,10"/>
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="Row" CornerRadius="12" Padding="16,11" Margin="0,3" BorderThickness="1"
                                        BorderBrush="Transparent" Background="Transparent">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="120"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource AccentSoftBrush}">
                                            <TextBlock x:Name="Icon" Text="{Binding Icon}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15"
                                                       Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0"/>
                                        <Border x:Name="Badge" Grid.Column="2" CornerRadius="8" Padding="10,1" Margin="10,0" Background="{DynamicResource GoldBrush}"
                                                Visibility="Collapsed" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Badge}" FontSize="12" FontWeight="SemiBold" Foreground="#0B1F3A"/>
                                        </Border>
                                        <Button x:Name="LogButton" Grid.Column="3" Content="{Binding LogText}" Padding="12,3" Margin="6,0" FontSize="12.5"
                                                VerticalAlignment="Center" Click="Log_Click" Tag="{Binding}"
                                                Visibility="{Binding CanLog, Converter={StaticResource BoolVis}}" ToolTip="كيف صليتها؟"/>
                                        <TextBlock Grid.Column="4" Text="{Binding Time}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" FlowDirection="LeftToRight"/>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Log}" Value="Mosque">
                                        <Setter TargetName="LogButton" Property="Background" Value="#3312A372"/>
                                        <Setter TargetName="LogButton" Property="Foreground" Value="#2FD39A"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Log}" Value="Jamaah">
                                        <Setter TargetName="LogButton" Property="Background" Value="#333B82F6"/>
                                        <Setter TargetName="LogButton" Property="Foreground" Value="#7FB0FF"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Log}" Value="Alone">
                                        <Setter TargetName="LogButton" Property="Background" Value="{DynamicResource GoldSoftBrush}"/>
                                        <Setter TargetName="LogButton" Property="Foreground" Value="{DynamicResource GoldBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Log}" Value="Qada">
                                        <Setter TargetName="LogButton" Property="Background" Value="#33E57373"/>
                                        <Setter TargetName="LogButton" Property="Foreground" Value="#E57373"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsPassed}" Value="True">
                                        <Setter TargetName="Row" Property="Opacity" Value="0.55"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                        <Setter TargetName="Row" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                        <Setter TargetName="Badge" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="Badge" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsNext}" Value="True">
                                        <Setter TargetName="Row" Property="Background" Value="{DynamicResource GoldSoftBrush}"/>
                                        <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource GoldBrush}"/>
                                        <Setter TargetName="Badge" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource GoldBrush}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource Muted}" Margin="4,0" FontSize="12">
                <Run Text="{l:Tr Method}"/><Run Text=": "/><Run Text="{Binding MethodText, Mode=OneWay}"/>
                <Run Text="  •  "/><Run Text="{Binding SourceText, Mode=OneWay}"/>
            </TextBlock>
        </StackPanel>
    </ScrollViewer>
</UserControl>
