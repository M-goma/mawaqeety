<UserControl x:Class="Mawaqeety.App.Views.RamadanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Mawaqeety.App.Controls">
    <UserControl.Resources>
        <c:BoolToVisibilityConverter x:Key="BoolVis"/>
        <c:NotEmptyToVisibilityConverter x:Key="NotEmpty"/>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,24" MaxWidth="980">
            <!-- Hero: today in Ramadan, or the countdown to the next one -->
            <Border Style="{StaticResource HeroCard}">
                <DockPanel>
                    <TextBlock Text="🌙" Style="{StaticResource HeroEmoji}"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding HeroTop}" Foreground="{DynamicResource HeroMutedBrush}" FontSize="15"/>
                        <TextBlock Text="{Binding HeroMain}" Foreground="White" FontSize="32" FontWeight="Bold"/>
                        <ProgressBar Style="{StaticResource HeroProgress}" Value="{Binding Progress, Mode=OneWay}" Margin="0,10,0,2"
                                     Visibility="{Binding InRamadan, Converter={StaticResource BoolVis}}"/>
                        <TextBlock Text="{Binding HeroSub}" Foreground="#E9C75A" FontSize="13.5"
                                   Visibility="{Binding HeroSub, Converter={StaticResource NotEmpty}}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <TextBlock Text="{Binding TodayTitle}" Style="{StaticResource Section}"/>
            <Border Style="{StaticResource Card}" Padding="20,10">
                <StackPanel>
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding FastToday}" Margin="0,8"
                              Visibility="{Binding InRamadan, Converter={StaticResource BoolVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🍽️" FontFamily="Segoe UI Emoji" FontSize="18" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="صمت اليوم" FontSize="15" VerticalAlignment="Center"/>
                        </StackPanel>
                    </CheckBox>
                    <StackPanel Margin="0,6,0,10" Visibility="{Binding InRamadan, Converter={StaticResource BoolVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🕌" FontFamily="Segoe UI Emoji" FontSize="18" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="صلاة التراويح" FontSize="15" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Rakahs}" Margin="30,8,0,0">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ToggleButton Content="{Binding Label}" IsChecked="{Binding Selected, Mode=OneWay}" Margin="0,0,8,6" Padding="14,5"
                                                  Command="{Binding DataContext.SetTaraweehCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding Rakahs}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Tahajjud}" Margin="0,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✨" FontFamily="Segoe UI Emoji" FontSize="18" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="قمت الليل (التهجد)" FontSize="15"/>
                                <TextBlock Text="{Binding QiyamText}" Style="{StaticResource Muted}" FontSize="12"
                                           Visibility="{Binding QiyamText, Converter={StaticResource NotEmpty}}"/>
                            </StackPanel>
                        </StackPanel>
                    </CheckBox>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding StatsTitle}" Style="{StaticResource Section}"/>
            <UniformGrid Columns="3" Margin="0,0,-12,0">
                <Border Style="{StaticResource StatTile}"><StackPanel>
                    <TextBlock Text="🍽️" FontFamily="Segoe UI Emoji" FontSize="20" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding FastedText}" Style="{StaticResource StatValue}"/>
                    <TextBlock Text="أيام الصيام" Style="{StaticResource Muted}" HorizontalAlignment="Center"/></StackPanel></Border>
                <Border Style="{StaticResource StatTile}"><StackPanel>
                    <TextBlock Text="🕌" FontFamily="Segoe UI Emoji" FontSize="20" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding TaraweehText}" Style="{StaticResource StatValue}"/>
                    <TextBlock Text="{Binding RakahsText}" Style="{StaticResource Muted}" HorizontalAlignment="Center"/></StackPanel></Border>
                <Border Style="{StaticResource StatTile}"><StackPanel>
                    <TextBlock Text="✨" FontFamily="Segoe UI Emoji" FontSize="20" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding TahajjudText}" Style="{StaticResource StatValue}"/>
                    <TextBlock Text="ليالي التهجد" Style="{StaticResource Muted}" HorizontalAlignment="Center"/></StackPanel></Border>
            </UniformGrid>

            <Border Style="{StaticResource Card}" Padding="16">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Days}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="10"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="54" Margin="3">
                                    <Border x:Name="Bg" CornerRadius="10" Background="{DynamicResource Surface2Brush}"/>
                                    <Border CornerRadius="10" Background="{DynamicResource AccentBrush}" Opacity="{Binding Fill}"/>
                                    <Border x:Name="Frame" CornerRadius="10" BorderThickness="1.5" BorderBrush="Transparent"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Number}" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding Icons}" FontFamily="Segoe UI Emoji" FontSize="10" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding LastTen}" Value="True">
                                        <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource GoldBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsToday}" Value="True">
                                        <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource TextBrush}"/>
                                        <Setter TargetName="Frame" Property="BorderThickness" Value="2.5"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="🍽️ صيام  •  🕌 تراويح  •  ✨ تهجد  •  الإطار الذهبي: العشر الأواخر" Style="{StaticResource Muted}" FontSize="12" Margin="4,10,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="20,14">
                <StackPanel>
                    <TextBlock Text="«مَن قامَ رَمَضانَ إيمانًا واحْتِسابًا، غُفِرَ له ما تَقَدَّمَ مِن ذَنْبِهِ»" Style="{StaticResource QuoteText}"/>
                    <TextBlock Text="صحيح البخاري ٣٧ • صحيح مسلم ٧٥٩" Style="{StaticResource Muted}" FontSize="12"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
