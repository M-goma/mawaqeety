<UserControl x:Class="Mawaqeety.App.Views.AsmaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Mawaqeety.App.Controls">
    <UserControl.Resources>
        <c:BoolToVisibilityConverter x:Key="BoolVis"/>
        <c:EmptyToVisibilityConverter x:Key="Empty"/>
    </UserControl.Resources>
    <Grid Margin="32,28,32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <!-- Name of the day -->
        <Border Grid.ColumnSpan="3" Style="{StaticResource HeroCard}" Padding="28,16">
            <DockPanel>
                <Button DockPanel.Dock="Right" VerticalAlignment="Center" Padding="14,6" Background="#26FFFFFF" Foreground="White" BorderBrush="#40FFFFFF"
                        Content="عرض المعنى" Command="{Binding SelectCommand}" CommandParameter="{Binding OfDay}"/>
                <StackPanel>
                    <TextBlock Text="اسم اليوم" Foreground="{DynamicResource HeroMutedBrush}" FontSize="15"/>
                    <TextBlock Text="{Binding OfDay.Name}" FontFamily="{StaticResource QuranFont}" Foreground="White" FontSize="40" LineHeight="70"/>
                    <TextBlock Text="{Binding OfDay.Meaning}" Foreground="#E9C75A" FontSize="15" TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Search and the grid -->
        <DockPanel Grid.Row="1">
            <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                <TextBox x:Name="SearchBox" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" Padding="34,7,10,7"/>
                <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource TextMutedBrush}"
                           HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False"/>
                <TextBlock Text="ابحث عن اسم أو معنى" Foreground="{DynamicResource TextMutedBrush}" IsHitTestVisible="False"
                           VerticalAlignment="Center" Margin="36,0,0,0" FontSize="13"
                           Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource Empty}}"/>
            </Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Width="132" Height="92" Margin="0,0,10,10" Padding="4" Background="{DynamicResource SurfaceBrush}"
                                        Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Number}" FontSize="11.5" Foreground="{DynamicResource GoldBrush}" HorizontalAlignment="Center"/>
                                        <Viewbox StretchDirection="DownOnly" MaxWidth="120">
                                            <TextBlock Text="{Binding Name}" FontFamily="{StaticResource QuranFont}" FontSize="24" LineHeight="44"/>
                                        </Viewbox>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="لا توجد نتائج" Style="{StaticResource Muted}" Margin="4,8"
                               Visibility="{Binding Items.Count, Converter={x:Static c:ZeroVisibility.Instance}}"/>
                    <TextBlock Text="{Binding Notes}" Style="{StaticResource Muted}" FontSize="12" LineHeight="22" Margin="4,10,4,10"/>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <!-- The selected name -->
        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top" Padding="22,20" BorderBrush="{DynamicResource GoldBrush}">
            <StackPanel>
                <TextBlock Text="{Binding Selected.Number}" Foreground="{DynamicResource GoldBrush}" HorizontalAlignment="Center" FontSize="14"/>
                <TextBlock Text="{Binding Selected.Name}" FontFamily="{StaticResource QuranFont}" FontSize="44" LineHeight="80" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Selected.Meaning}" FontSize="16.5" LineHeight="30" TextWrapping="Wrap" TextAlignment="Center"/>
                <TextBlock Text="{Binding DisputedNote}" Style="{StaticResource Muted}" FontSize="12.5" TextAlignment="Center" Margin="0,10,0,0"
                           Visibility="{Binding Selected.Disputed, Converter={StaticResource BoolVis}}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
