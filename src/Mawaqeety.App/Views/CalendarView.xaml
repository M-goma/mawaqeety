<UserControl x:Class="Mawaqeety.App.Views.CalendarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Mawaqeety.App.Controls">
    <UserControl.Resources>
        <c:BoolToVisibilityConverter x:Key="BoolVis"/>
        <Style x:Key="DayButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="32,28,32,24" MaxWidth="1100">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <Border Style="{StaticResource HeroCard}" Padding="14,14">
                    <DockPanel>
                        <Button DockPanel.Dock="Left" Command="{Binding PrevMonthCommand}" Padding="10,6" Background="#26FFFFFF" Foreground="White" BorderBrush="#66FFFFFF"
                                ToolTip="الشهر السابق" VerticalAlignment="Center">
                            <TextBlock Text="&#xE76C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"/>
                        </Button>
                        <Button DockPanel.Dock="Right" Command="{Binding NextMonthCommand}" Padding="10,6" Background="#26FFFFFF" Foreground="White" BorderBrush="#66FFFFFF"
                                ToolTip="الشهر التالي" VerticalAlignment="Center">
                            <TextBlock Text="&#xE76B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"/>
                        </Button>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" Foreground="White" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding HijriSpan}" Foreground="#E9C75A" FontSize="13.5" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Saturday first; the row runs right to left in Arabic -->
                <ItemsControl ItemsSource="{Binding Weekdays}" Margin="0,0,0,6">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock x:Name="W" Text="{Binding}" HorizontalAlignment="Center" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding}" Value="جمعة">
                                    <Setter TargetName="W" Property="Foreground" Value="{DynamicResource GoldBrush}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding Cells}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button x:Name="Btn" Style="{StaticResource DayButton}" Margin="3" Height="64" ToolTip="{Binding Tooltip}"
                                    Command="{Binding DataContext.SelectDayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                <Border x:Name="Cell" CornerRadius="10" Background="{DynamicResource Surface2Brush}" BorderThickness="1.2" BorderBrush="Transparent">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock x:Name="Day" Text="{Binding DayText}" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="Hijri" Text="{Binding HijriText}" FontSize="11.5" Foreground="{DynamicResource GoldBrush}" HorizontalAlignment="Center"/>
                                        <Ellipse x:Name="Dot" Width="5" Height="5" Fill="{DynamicResource GoldBrush}" Margin="0,2,0,0" Visibility="{Binding IsSpecial, Converter={StaticResource BoolVis}}"/>
                                    </StackPanel>
                                </Border>
                            </Button>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsBlank}" Value="True">
                                    <Setter TargetName="Btn" Property="Visibility" Value="Hidden"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsFriday}" Value="True">
                                    <Setter TargetName="Day" Property="Foreground" Value="{DynamicResource GoldBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSpecial}" Value="True">
                                    <Setter TargetName="Cell" Property="Background" Value="{DynamicResource GoldSoftBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsWhite}" Value="True">
                                    <Setter TargetName="Cell" Property="BorderBrush" Value="{DynamicResource GoldBrush}"/>
                                </DataTrigger>
                                <DataTrigger Value="True">
                                    <DataTrigger.Binding>
                                        <MultiBinding Converter="{x:Static c:Equal.Instance}">
                                            <Binding/>
                                            <Binding Path="DataContext.SelectedDay" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                        </MultiBinding>
                                    </DataTrigger.Binding>
                                    <Setter TargetName="Cell" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                    <Setter TargetName="Cell" Property="BorderThickness" Value="2"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsToday}" Value="True">
                                    <Setter TargetName="Cell" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                    <Setter TargetName="Day" Property="Foreground" Value="White"/>
                                    <Setter TargetName="Hijri" Property="Foreground" Value="#D9FFFFFF"/>
                                    <Setter TargetName="Dot" Property="Fill" Value="White"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Center" Margin="0,8,0,0" Command="{Binding ThisMonthCommand}"
                        Visibility="{Binding IsCurrentMonth, Converter={StaticResource BoolVis}, ConverterParameter=inv}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8D1;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,2,6,0"/>
                        <TextBlock Text="العودة إلى اليوم"/>
                    </StackPanel>
                </Button>
                <WrapPanel Margin="4,10,4,0">
                    <Border Width="14" Height="14" CornerRadius="4" Background="{DynamicResource GoldSoftBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="مناسبة" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,16,0"/>
                    <Border Width="14" Height="14" CornerRadius="4" BorderBrush="{DynamicResource GoldBrush}" BorderThickness="1.2" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="الأيام البيض" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,16,0"/>
                    <Border Width="14" Height="14" CornerRadius="4" Background="{DynamicResource AccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="اليوم" Style="{StaticResource Muted}" FontSize="12"/>
                </WrapPanel>
                <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="4,10,4,0"
                           Text="التاريخ الهجري بالحساب الفلكي (أم القرى)، ويمكن تعديله يومًا أو يومين من الإعدادات بحسب رؤية الهلال في بلدك."/>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource Card}" Padding="18,14">
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedTitle}" FontSize="17" FontWeight="Bold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding SelectedHijri}" Foreground="{DynamicResource GoldBrush}" FontSize="14.5"/>
                        <TextBlock Text="{Binding SelectedEvents}" TextWrapping="Wrap" FontSize="14.5" LineHeight="26" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="في هذا الشهر" Style="{StaticResource Section}"
                           Visibility="{Binding Events.Count, Converter={x:Static c:ZeroVisibility.Instance}, ConverterParameter=inv}"/>
                <Border Style="{StaticResource Card}" Padding="14,8"
                        Visibility="{Binding Events.Count, Converter={x:Static c:ZeroVisibility.Instance}, ConverterParameter=inv}">
                    <ItemsControl ItemsSource="{Binding Events}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,6">
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding DayText}" Width="34" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource GoldBrush}"
                                               VerticalAlignment="Center"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" FontSize="11.5"/>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
