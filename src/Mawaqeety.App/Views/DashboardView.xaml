<UserControl x:Class="Mawaqeety.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Mawaqeety.App.Localization"
             xmlns:c="clr-namespace:Mawaqeety.App.Controls">
    <UserControl.Resources>
        <c:BoolToVisibilityConverter x:Key="BoolVis"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,24" MaxWidth="980">

            <!-- Header: location, dates, live clock -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE707;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18"
                                   Foreground="{DynamicResource GoldBrush}" VerticalAlignment="Center" Margin="0,4,10,0"/>
                        <TextBlock Text="{Binding CityName}" Style="{StaticResource H1}"/>
                        <Button Style="{StaticResource GhostButton}" Margin="10,4,0,0" Command="{Binding ChangeLocationCommand}"
                                ToolTip="{l:Tr ChangeLocation}" Foreground="{DynamicResource TextMutedBrush}">
                            <TextBlock Text="&#xE70F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"/>
                        </Button>
                    </StackPanel>
                    <TextBlock Margin="0,4,0,0" FontSize="14" Foreground="{DynamicResource TextMutedBrush}">
                        <Run Text="{Binding GregorianDate, Mode=OneWay}"/>
                        <Run Text="  •  " Foreground="{DynamicResource GoldBrush}"/>
                        <Run Text="{Binding HijriDate, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding Clock}" FontSize="30" FontWeight="SemiBold" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextBrush}" FlowDirection="LeftToRight"/>
            </Grid>

            <!-- Paused banner -->
            <Border Visibility="{Binding IsPaused, Converter={StaticResource BoolVis}}" Background="{DynamicResource GoldSoftBrush}"
                    BorderBrush="{DynamicResource GoldBrush}" BorderThickness="1" CornerRadius="10" Padding="14,8" Margin="0,0,0,14">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="{l:Tr Resume}" Style="{StaticResource PrimaryButton}" Command="{Binding ResumeCommand}" Padding="14,4"/>
                    <TextBlock Text="&#xE769;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,10,0"
                               Foreground="{DynamicResource GoldBrush}"/>
                    <TextBlock Text="{Binding PausedText}" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                </DockPanel>
            </Border>

            <!-- Hero: next prayer + countdown -->
            <Border Background="{DynamicResource HeroBrush}" Effect="{StaticResource HeroShadow}" BorderBrush="{StaticResource RimBrush}" BorderThickness="0,1,0,0" CornerRadius="20" Padding="30,26" Margin="0,0,0,20">
                <Grid>
                    <!-- decorative arch -->
                    <Path HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-6,-26" Opacity="0.10" Stretch="Uniform" Height="180"
                          Stroke="#FFFFFF" StrokeThickness="6" Data="M0,200 L0,80 A60,60 0 0 1 120,80 L120,200"/>
                    <StackPanel>
                        <TextBlock Text="{l:Tr NextPrayer}" FontSize="15" Foreground="{DynamicResource HeroMutedBrush}"/>
                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                <TextBlock Text="{Binding NextPrayerName}" FontSize="40" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="{Binding NextPrayerTime}" FontSize="20" Foreground="#E9C75A" Margin="16,0,0,10"
                                           VerticalAlignment="Bottom"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                <TextBlock Text="{l:Tr TimeRemaining}" FontSize="13" Foreground="{DynamicResource HeroMutedBrush}" HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding Countdown}" FontSize="44" FontWeight="Bold" Foreground="White" FlowDirection="LeftToRight"
                                           HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>
                        <ProgressBar Style="{StaticResource HeroProgress}" Value="{Binding Progress, Mode=OneWay}" Margin="0,16,0,10"/>
                        <TextBlock Text="{Binding CurrentStatus}" FontSize="13.5" Foreground="{DynamicResource HeroMutedBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Quran radio (Cairo) -->
            <Border Style="{StaticResource Card}" Padding="16,12">
                <DockPanel>
                    <Button DockPanel.Dock="Left" Command="{Binding ToggleRadioCommand}" Width="54" Height="54" Cursor="Hand"
                            ToolTip="تشغيل / إيقاف الإذاعة">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid>
                                    <Ellipse Effect="{StaticResource RaisedShadow}">
                                        <Ellipse.Fill>
                                            <RadialGradientBrush GradientOrigin="0.32,0.25" Center="0.4,0.35" RadiusX="0.75" RadiusY="0.75">
                                                <GradientStop Color="#FFF3B8" Offset="0"/>
                                                <GradientStop Color="#E9C75A" Offset="0.35"/>
                                                <GradientStop Color="#B8901F" Offset="0.75"/>
                                                <GradientStop Color="#7A5C0C" Offset="1"/>
                                            </RadialGradientBrush>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <TextBlock x:Name="Glyph" Text="&#xE768;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20"
                                               Foreground="#3A2A00" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding RadioOn}" Value="True">
                                        <Setter TargetName="Glyph" Property="Text" Value="&#xE71A;"/>
                                    </DataTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="إيقاف بعد:" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Button Content="١٥ د" Command="{Binding RadioSleepForCommand}" CommandParameter="15" Padding="10,4" Margin="2,0"/>
                        <Button Content="٣٠ د" Command="{Binding RadioSleepForCommand}" CommandParameter="30" Padding="10,4" Margin="2,0"/>
                        <Button Content="ساعة" Command="{Binding RadioSleepForCommand}" CommandParameter="60" Padding="10,4" Margin="2,0"/>
                        <Button Content="بدون" Command="{Binding RadioSleepForCommand}" CommandParameter="0" Padding="10,4" Margin="2,0"/>
                    </StackPanel>
                    <StackPanel Margin="14,0" VerticalAlignment="Center">
                        <TextBlock Text="📻 إذاعة القرآن الكريم من القاهرة" FontWeight="SemiBold" FontSize="15.5"/>
                        <TextBlock Text="{Binding RadioStatus}" Style="{StaticResource Muted}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Today's harvest: prayers, adhkar and wird -->
            <Border Background="{DynamicResource HeroBrush}" Effect="{StaticResource HeroShadow}" BorderBrush="{StaticResource RimBrush}" BorderThickness="0,1,0,0" CornerRadius="18" Padding="18,14" Margin="0,0,0,14" Cursor="Hand"
                    MouseLeftButtonUp="Harvest_Click">
                <DockPanel>
                    <Grid DockPanel.Dock="Left" Width="78" Height="78" Margin="0,0,16,0">
                        <Ellipse Stroke="#33FFFFFF" StrokeThickness="8"/>
                        <c:Arc Progress="{Binding Harvest}" Stroke="#E9C75A" StrokeThickness="8"/>
                        <TextBlock Text="{Binding HarvestPercent}" Foreground="White" FontWeight="Bold" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock DockPanel.Dock="Right" Text="إحصائياتي ›" Foreground="#E9C75A" VerticalAlignment="Top"/>
                    <StackPanel>
                        <TextBlock Text="حصاد اليوم" Foreground="White" FontWeight="Bold" FontSize="17"/>
                        <TextBlock Text="{Binding HarvestLeft}" Foreground="{DynamicResource HeroMutedBrush}" FontSize="13" TextWrapping="Wrap"/>
                        <WrapPanel Margin="0,8,0,0">
                            <Border CornerRadius="10" Background="#26FFFFFF" Padding="10,2" Margin="0,0,6,0">
                                <TextBlock Text="{Binding PrayersChip}" Foreground="White" FontSize="12.5"/>
                            </Border>
                            <ToggleButton IsChecked="{Binding MorningDone, Mode=OneWay}" Command="{Binding ToggleMorningCommand}" Padding="10,2" Margin="0,0,6,0"
                                          Background="#26FFFFFF" Foreground="White" BorderThickness="0" Content="☀️ أذكار الصباح" FontSize="12.5"
                                          ToolTip="اضغط لتسجيلها أو إلغاء تسجيلها"/>
                            <ToggleButton IsChecked="{Binding EveningDone, Mode=OneWay}" Command="{Binding ToggleEveningCommand}" Padding="10,2" Margin="0,0,6,0"
                                          Background="#26FFFFFF" Foreground="White" BorderThickness="0" Content="🌙 أذكار المساء" FontSize="12.5"
                                          ToolTip="اضغط لتسجيلها أو إلغاء تسجيلها"/>
                            <Border CornerRadius="10" Background="#26FFFFFF" Padding="10,2" Visibility="{Binding HasWird, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="{Binding WirdChip}" Foreground="White" FontSize="12.5"/>
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Hadith of the day (Sahih al-Bukhari) -->
            <Border Style="{StaticResource Card}" Padding="18,14">
                <StackPanel>
                    <TextBlock Text="✦ حديث اليوم" Foreground="{DynamicResource GoldBrush}" FontWeight="Bold" FontSize="15"/>
                    <TextBlock Text="{Binding HadithText}" TextWrapping="Wrap" FontFamily="{StaticResource QuranFont}" FontSize="19" LineHeight="38" Margin="0,4,0,0"/>
                    <Border CornerRadius="8" Background="#2912A372" Padding="8,2" HorizontalAlignment="Left" Margin="0,6,0,0">
                        <TextBlock Text="{Binding HadithRef}" FontSize="12" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
