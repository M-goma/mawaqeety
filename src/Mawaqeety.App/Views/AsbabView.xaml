<UserControl x:Class="Mawaqeety.App.Views.AsbabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Mawaqeety.App.Controls">
    <UserControl.Resources>
        <c:BoolToVisibilityConverter x:Key="BoolVis"/>
        <c:NotEmptyToVisibilityConverter x:Key="NotEmpty"/>
    </UserControl.Resources>

    <Grid Margin="24,24,24,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Counts, filter and the surahs -->
        <DockPanel>
            <Border DockPanel.Dock="Top" Background="{DynamicResource HeroBrush}" Effect="{StaticResource HeroShadow}" BorderBrush="{StaticResource RimBrush}"
                    BorderThickness="0,1,0,0" CornerRadius="18" Padding="12,12" Margin="0,0,0,12">
                <StackPanel>
                    <UniformGrid Columns="3">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding MeccanCount}" Foreground="#E9C75A" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="سورة مكية" Foreground="White" FontSize="12" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding MedinanCount}" Foreground="#E9C75A" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="سورة مدنية" Foreground="White" FontSize="12" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding NarrationCount}" Foreground="#E9C75A" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="رواية صحيحة" Foreground="White" FontSize="12" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </UniformGrid>
                    <TextBlock Text="{Binding HeroSub}" Foreground="{DynamicResource HeroMutedBrush}" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <RadioButton Style="{StaticResource Segment}" GroupName="asbabFilter" Content="الكل" IsChecked="{Binding IsAll}" Margin="0,0,4,4"/>
                <RadioButton Style="{StaticResource Segment}" GroupName="asbabFilter" Content="مكية" IsChecked="{Binding IsMeccan}" Margin="0,0,4,4"/>
                <RadioButton Style="{StaticResource Segment}" GroupName="asbabFilter" Content="مدنية" IsChecked="{Binding IsMedinan}" Margin="0,0,4,4"/>
                <RadioButton Style="{StaticResource Segment}" GroupName="asbabFilter" Content="فيها سبب نزول صحيح" IsChecked="{Binding IsWithAsbab}" Margin="0,0,4,4"/>
            </WrapPanel>
            <ListBox ItemsSource="{Binding Surahs}" SelectedItem="{Binding Selected}" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="2,4">
                            <Border DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="17" Background="{DynamicResource AccentSoftBrush}" Margin="0,0,10,0">
                                <TextBlock Text="{Binding NumberText}" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock DockPanel.Dock="Right" Text="&#xE736;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                                       Foreground="{DynamicResource GoldBrush}" VerticalAlignment="Center" Margin="6,0,2,0" ToolTip="فيها سبب نزول صحيح"
                                       Visibility="{Binding HasAsbab, Converter={StaticResource BoolVis}}"/>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                    <Border x:Name="Type" CornerRadius="7" Background="{DynamicResource AccentSoftBrush}" Padding="6,0" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="TypeText" Text="{Binding TypeText}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                            </StackPanel>
                        </DockPanel>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsMeccan}" Value="True">
                                <Setter TargetName="Type" Property="Background" Value="{DynamicResource GoldSoftBrush}"/>
                                <Setter TargetName="TypeText" Property="Foreground" Value="{DynamicResource GoldBrush}"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- One surah -->
        <ScrollViewer x:Name="Scroll" Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="900" Margin="0,0,8,24">
                <Border Background="{DynamicResource HeroBrush}" Effect="{StaticResource HeroShadow}" BorderBrush="{StaticResource RimBrush}"
                        BorderThickness="0,1,0,0" CornerRadius="18" Padding="22,16" Margin="0,0,0,16">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding Title}" Foreground="White" FontFamily="{StaticResource QuranFont}" FontSize="28" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding Facts}" Foreground="#E9C75A" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding Count}" Foreground="{DynamicResource HeroMutedBrush}" FontSize="13" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource Muted}" TextAlignment="Center" LineHeight="28" Margin="24,8,24,16" Visibility="{Binding IsEmpty, Converter={StaticResource BoolVis}}"
                           Text="لم نجد في صحيحَي البخاري ومسلم رواية تصرّح بسبب نزول آية من هذه السورة وتذكرها. ولا يعني ذلك أنه لا سبب لها؛ فأكثر القرآن نزل ابتداءً، وقد يصح السبب في غير الصحيحين."/>

                <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="20,14" Margin="0,0,0,12">
                                <StackPanel>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Foreground="{DynamicResource GoldBrush}" ToolTip="استماع للتلاوة بصوت القارئ المختار"
                                                Command="{Binding DataContext.ReciteAyatCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Ayat}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE768;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,2,6,0"/>
                                                <TextBlock Text="استماع"/>
                                            </StackPanel>
                                        </Button>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="فتح في المصحف" Foreground="{DynamicResource AccentBrush}"
                                                Command="{Binding DataContext.OpenInQuranCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Ayat}"/>
                                        <TextBlock Text="{Binding AyahLabel}" Foreground="{DynamicResource GoldBrush}" FontWeight="Bold" FontSize="15.5" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <TextBlock Text="{Binding Ayat.Text}" FontFamily="{StaticResource QuranFont}" FontSize="22" TextWrapping="Wrap" TextAlignment="Justify"
                                               LineHeight="44" LineStackingStrategy="BlockLineHeight" Margin="0,6,0,0"/>
                                    <ItemsControl ItemsSource="{Binding Narrations}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <Separator Margin="0,10" Background="{DynamicResource LineBrush}"/>
                                                    <TextBlock Text="{Binding Excerpt}" TextWrapping="Wrap" FontSize="15" LineHeight="29"/>
                                                    <DockPanel Margin="0,6,0,0">
                                                        <ToggleButton DockPanel.Dock="Right" IsChecked="{Binding Full.IsOpen, Mode=OneWay}" Command="{Binding Full.ToggleCommand}" Padding="10,4">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xE82D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,2,6,0"/>
                                                                <TextBlock Text="{Binding Full.Label}"/>
                                                            </StackPanel>
                                                        </ToggleButton>
                                                        <Border CornerRadius="8" Background="#2912A372" Padding="8,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Ref}" FontSize="12" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/>
                                                        </Border>
                                                    </DockPanel>
                                                    <Border Visibility="{Binding Full.IsOpen, Converter={StaticResource BoolVis}}" Background="{DynamicResource Surface2Brush}"
                                                            CornerRadius="10" Padding="14,10" Margin="0,8,0,0">
                                                        <StackPanel>
                                                            <TextBlock Text="جارٍ التحميل…" Style="{StaticResource Muted}" Visibility="{Binding Full.Loading, Converter={StaticResource BoolVis}}"/>
                                                            <TextBlock Text="{Binding Full.Text}" TextWrapping="Wrap" FontFamily="{StaticResource QuranFont}" FontSize="18" LineHeight="36"/>
                                                            <TextBlock Text="{Binding Full.Reference}" FontSize="12" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"
                                                                       Visibility="{Binding Full.Reference, Converter={StaticResource NotEmpty}}"/>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{Binding Note}" Style="{StaticResource Muted}" FontSize="12" TextAlignment="Center" LineHeight="22" Margin="12,8,12,0"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
