<UserControl x:Class="Mawaqeety.App.Views.StatsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Mawaqeety.App.Controls">
    <UserControl.Resources>
        <c:BoolToVisibilityConverter x:Key="BoolVis"/>
        <Style x:Key="StreakCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Padding" Value="12,10"/>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,28,24" MaxWidth="980">
            <DockPanel Margin="0,0,0,12">
                <Border DockPanel.Dock="Right" CornerRadius="10" Background="{DynamicResource SurfaceBrush}" Padding="3">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Segment}" Tag="&#xE787;" Content="آخر ٧ أيام" GroupName="range"
                                     IsChecked="{Binding IsMonth, Converter={x:Static c:Not.Instance}, Mode=OneWay}" Command="{Binding ShowWeekCommand}"/>
                        <RadioButton Style="{StaticResource Segment}" Tag="&#xE8BF;" Content="هذا الشهر" GroupName="range"
                                     IsChecked="{Binding IsMonth, Mode=OneWay}" Command="{Binding ShowMonthCommand}"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="إحصائياتي" Style="{StaticResource H1}"/>
            </DockPanel>

            <UniformGrid Columns="3" Margin="0,0,-10,14">
                <Border Style="{StaticResource StreakCard}"><StackPanel>
                    <TextBlock Text="{Binding PrayersStreak}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="أيام متتالية للصلوات الخمس" Style="{StaticResource Muted}" HorizontalAlignment="Center"/></StackPanel></Border>
                <Border Style="{StaticResource StreakCard}"><StackPanel>
                    <TextBlock Text="{Binding FajrStreak}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="أيام الفجر في المسجد" Style="{StaticResource Muted}" HorizontalAlignment="Center"/></StackPanel></Border>
                <Border Style="{StaticResource StreakCard}"><StackPanel>
                    <TextBlock Text="{Binding MorningStreak}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="أيام أذكار الصباح" Style="{StaticResource Muted}" HorizontalAlignment="Center"/></StackPanel></Border>
            </UniformGrid>

            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <!-- Completion: the week as bars, or the month as a grid -->
                <Border Style="{StaticResource Card}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="اكتمال الأيام" Style="{StaticResource H2}"/>
                        <TextBlock Text="الصلوات الخمس + أذكار الصباح والمساء + وردك من التسبيح" Style="{StaticResource Muted}" FontSize="12"/>
                        <ItemsControl ItemsSource="{Binding Week}" Height="170" Margin="0,10,0,0"
                                      Visibility="{Binding IsMonth, Converter={StaticResource BoolVis}, ConverterParameter=inv}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="5,0">
                                        <TextBlock x:Name="Day" DockPanel.Dock="Bottom" Text="{Binding Label}" FontSize="11" HorizontalAlignment="Center"/>
                                        <Grid VerticalAlignment="Bottom" Height="140">
                                            <Border VerticalAlignment="Bottom" CornerRadius="6,6,2,2" Background="{DynamicResource AccentBrush}"
                                                    Height="{Binding Value, Converter={x:Static c:Scale.Bar}}"/>
                                            <TextBlock Text="{Binding ValueText}" FontSize="10.5" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                                        </Grid>
                                    </DockPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsToday}" Value="True">
                                            <Setter TargetName="Day" Property="FontWeight" Value="Bold"/>
                                            <Setter TargetName="Day" Property="Foreground" Value="{DynamicResource GoldBrush}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Visibility="{Binding IsMonth, Converter={StaticResource BoolVis}}" Margin="0,10,0,0">
                            <TextBlock Text="{Binding MonthTitle}" Foreground="{DynamicResource GoldBrush}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <ItemsControl ItemsSource="{Binding MonthCells}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="34" Margin="2">
                                            <Border x:Name="Bg" CornerRadius="6" Background="{DynamicResource Surface2Brush}"/>
                                            <Border x:Name="Fill" CornerRadius="6" Background="{DynamicResource AccentBrush}" Opacity="{Binding Value}"/>
                                            <TextBlock Text="{Binding Text}" FontSize="11.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsBlank}" Value="True">
                                                <Setter TargetName="Bg" Property="Visibility" Value="Hidden"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsFuture}" Value="True">
                                                <Setter TargetName="Bg" Property="Opacity" Value="0.35"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource GoldBrush}"/>
                                                <Setter TargetName="Bg" Property="BorderThickness" Value="2"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <!-- How the prayers were prayed -->
                <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="{Binding PrayersTitle}" Style="{StaticResource H2}"/>
                        <TextBlock Text="سجّل صلواتك من الشاشة الرئيسية لتظهر هنا." Style="{StaticResource Muted}" Margin="0,8,0,0"
                                   Visibility="{Binding HasPrayers, Converter={StaticResource BoolVis}, ConverterParameter=inv}"/>
                        <ItemsControl ItemsSource="{Binding Shares}" Margin="0,8,0,0" Visibility="{Binding HasPrayers, Converter={StaticResource BoolVis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,6">
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Label}" Width="150"/>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding ValueText}" Width="44" TextAlignment="Right"/>
                                        <ProgressBar Value="{Binding Value, Mode=OneWay}" Maximum="1" Height="9" BorderThickness="0" Background="{DynamicResource LineBrush}"
                                                     Foreground="{Binding Color, Converter={x:Static c:HexBrush.Instance}}" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding TasbeehText}" FontSize="15" FontWeight="SemiBold" Margin="0,16,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
            <TextBlock Text="{Binding Quote}" Foreground="{DynamicResource GoldBrush}" TextWrapping="Wrap" TextAlignment="Center" FontSize="15" Margin="0,18,0,6"/>
            <TextBlock Text="البيانات محفوظة على جهازك فقط، ولا تُرسل لأي مكان." Style="{StaticResource Muted}" HorizontalAlignment="Center" FontSize="12"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
