<UserControl x:Class="Mawaqeety.App.Views.AtlasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Mawaqeety.App.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,24" MaxWidth="980">
            <Border Style="{StaticResource HeroCard}">
                <DockPanel>
                    <TextBlock Text="🗺️" Style="{StaticResource HeroEmoji}"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="أطلس قصص الأنبياء" Foreground="White" FontSize="28" FontWeight="Bold"/>
                        <TextBlock Text="أماكن ذُكرت في القرآن أو السنة، أو عيّنها أكثر المفسرين، مع درجة اليقين في كل موضع."
                                   Foreground="#E9C75A" FontSize="13.5" TextWrapping="Wrap"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <DockPanel Margin="0,0,0,12">
                <TextBlock Text="عرض أماكن:" Style="{StaticResource Label}" Margin="4,0,10,0"/>
                <ComboBox Width="220" HorizontalAlignment="Left" ItemsSource="{Binding Filters}" DisplayMemberPath="Label" SelectedValuePath="Id"
                          SelectedValue="{Binding Filter}"/>
            </DockPanel>

            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="18,14" Margin="4,0,4,12">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right" CornerRadius="8" Padding="8,2" VerticalAlignment="Center"
                                                Background="{Binding CertaintySoft, Converter={x:Static c:HexBrush.Instance}}">
                                            <TextBlock Text="{Binding Certainty}" FontSize="11.5" FontWeight="Bold"
                                                       Foreground="{Binding CertaintyColor, Converter={x:Static c:HexBrush.Instance}}"/>
                                        </Border>
                                        <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="Bold" TextWrapping="Wrap"/>
                                    </DockPanel>
                                    <TextBlock Text="{Binding Note}" TextWrapping="Wrap" FontSize="14.5" LineHeight="27" Margin="0,6,0,0"/>
                                    <TextBlock Text="{Binding Source}" Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0"/>
                                </StackPanel>
                                <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0" VerticalAlignment="Bottom">
                                    <Button Style="{StaticResource GhostButton}" Foreground="{DynamicResource AccentBrush}" ToolTip="فتح الموضع في خرائط OpenStreetMap" Margin="0,0,6,0"
                                            Command="{Binding DataContext.OpenMapCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE707;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,2,6,0"/>
                                            <TextBlock Text="على الخريطة"/>
                                        </StackPanel>
                                    </Button>
                                    <ItemsControl ItemsSource="{Binding Prophets}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource GhostButton}" Foreground="{DynamicResource GoldBrush}" Margin="0,0,4,0"
                                                        Command="{Binding DataContext.OpenProphetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Id}">
                                                    <TextBlock>
                                                        <Run Text="قصة "/><Run Text="{Binding Label, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </WrapPanel>
                                <Border/>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="4,4,4,0"
                       Text="تُفتح المواضع في خرائط OpenStreetMap بالمتصفح. ما وُصف بأنه «قول أكثر المفسرين» أو «قول بعض المؤرخين» تقريبيّ، ولا يُقطع بتعيين موضعه."/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
