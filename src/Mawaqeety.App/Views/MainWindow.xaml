<Window x:Class="Mawaqeety.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Mawaqeety.App.Localization"
        xmlns:vm="clr-namespace:Mawaqeety.App.ViewModels"
        xmlns:v="clr-namespace:Mawaqeety.App.Views"
        Title="{l:Tr AppName}"
        Width="1080" Height="720" MinWidth="880" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/mawaqeety.ico"
        Background="{DynamicResource BgBrush}"
        FontFamily="{StaticResource AppFont}"
        Foreground="{DynamicResource TextBrush}"
        FlowDirection="{Binding FlowDirection, Source={x:Static l:Loc.I}}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><v:DashboardView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:MonthlyViewModel}"><v:MonthlyView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><v:SettingsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AboutViewModel}"><v:AboutView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:QuranViewModel}"><v:QuranView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProphetsViewModel}"><v:ProphetsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AdhkarViewModel}"><v:AdhkarView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:QiblaViewModel}"><v:QiblaView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:TasbeehViewModel}"><v:TasbeehView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:StatsViewModel}"><v:StatsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:TimesViewModel}"><v:TimesView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:HadithViewModel}"><v:HadithView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:CompanionsViewModel}"><v:CompanionsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SabeelViewModel}"><v:SabeelView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:RamadanViewModel}"><v:RamadanView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:WhiteDaysViewModel}"><v:WhiteDaysView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:OccasionsViewModel}"><v:OccasionsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AsmaViewModel}"><v:AsmaView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ZakatViewModel}"><v:ZakatView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:KhatmaViewModel}"><v:KhatmaView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ArbaeenViewModel}"><v:ArbaeenView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:FiqhViewModel}"><v:FiqhView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AsbabViewModel}"><v:AsbabView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:GhazawatViewModel}"><v:GhazawatView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:NasabViewModel}"><v:NasabView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:CompanionsIslamViewModel}"><v:CompanionsIslamView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:CalendarViewModel}"><v:CalendarView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AtlasViewModel}"><v:AtlasView/></DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="22,22,22,16">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="pack://application:,,,/Assets/logo.png" Width="44" Height="44" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{l:Tr AppName}" FontSize="21" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="{l:Tr Slogan}" FontSize="12" Foreground="#D4AF37"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <TextBlock DockPanel.Dock="Bottom" Margin="24,0,24,18" FontSize="11" Foreground="#7F93AE"
                           Text="{Binding About.Version, StringFormat=v{0}}"/>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel Margin="0,0,0,8">
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="&#xE80F;" Content="{l:Tr NavDashboard}" IsChecked="{Binding IsDashboard}"/>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="&#xE916;" Content="المواقيت" IsChecked="{Binding IsTimes}"/>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="&#xE787;" Content="{l:Tr NavMonthly}" IsChecked="{Binding IsMonthly}"/>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="&#xE8C0;" Content="التقويم الميلادي" IsChecked="{Binding IsCalendar}"/>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="&#xE736;" Content="{l:Tr NavQuran}" IsChecked="{Binding IsQuran}"/>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="&#xE7C3;" Content="أسباب النزول" IsChecked="{Binding IsAsbab}"/>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="&#xE8BD;" Content="اسأل سبيل" IsChecked="{Binding IsSabeel}"/>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="&#xE734;" Content="{l:Tr NavAdhkar}" IsChecked="{Binding IsAdhkar}"/>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="&#xE7C1;" Content="{l:Tr NavTasbeeh}" IsChecked="{Binding IsTasbeeh}"/>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="&#xE9D2;" Content="{l:Tr NavStats}" IsChecked="{Binding IsStats}"/>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="&#xE707;" Content="{l:Tr NavQibla}" IsChecked="{Binding IsQibla}"/>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="&#xE82D;" Content="{l:Tr NavProphets}" IsChecked="{Binding IsProphets}"/>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="&#xE774;" Content="أطلس قصص الأنبياء" IsChecked="{Binding IsAtlas}"/>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="&#xEA18;" Content="غزوات النبي ﷺ" IsChecked="{Binding IsGhazawat}"/>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="&#xE8F1;" Content="الأحاديث الصحيحة" IsChecked="{Binding IsHadith}"/>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="&#xE8A5;" Content="الأربعون النووية" IsChecked="{Binding IsArbaeen}"/>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="&#xE7BE;" Content="فقه العبادات" IsChecked="{Binding IsFiqh}"/>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="&#xE734;" Content="العشرة المبشرون" IsChecked="{Binding IsCompanions}"/>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="&#xE716;" Content="كيف أسلم الصحابة" IsChecked="{Binding IsCompanionsIslam}"/>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="&#xE71B;" Content="النسب الشريف" IsChecked="{Binding IsNasab}"/>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="&#xE708;" Content="رمضان" IsChecked="{Binding IsRamadan}"/>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="&#xE706;" Content="الأيام البيض" IsChecked="{Binding IsWhiteDays}"/>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="&#xE8BF;" Content="المناسبات" IsChecked="{Binding IsOccasions}"/>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="&#xE735;" Content="أسماء الله الحسنى" IsChecked="{Binding IsAsma}"/>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="&#xE8EF;" Content="حاسبة الزكاة" IsChecked="{Binding IsZakat}"/>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="&#xE713;" Content="{l:Tr NavSettings}" IsChecked="{Binding IsSettings}"/>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Tag="&#xE946;" Content="{l:Tr NavAbout}" IsChecked="{Binding IsAbout}"/>
                </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Page content with a subtle slide/fade transition -->
        <ContentControl x:Name="PageHost" Grid.Column="1" Content="{Binding CurrentView}" Focusable="False">
            <ContentControl.RenderTransform>
                <TranslateTransform x:Name="PageShift"/>
            </ContentControl.RenderTransform>
        </ContentControl>
    </Grid>
</Window>
