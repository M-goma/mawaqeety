<Window x:Class="Mawaqeety.App.Views.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="مواقيتي" Width="260" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" ShowActivated="False" FontFamily="{StaticResource AppFont}" FlowDirection="RightToLeft"
        UseLayoutRounding="True">
    <Border x:Name="Card" CornerRadius="18" Background="{DynamicResource HeroBrush}" Padding="16,12,16,14" Margin="8"
            MouseLeftButtonDown="Card_MouseLeftButtonDown" Cursor="SizeAll">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.35"/>
        </Border.Effect>
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="فتح مواقيتي" Click="Open_Click"/>
                <MenuItem x:Name="TopmostItem" Header="تبقى فوق كل النوافذ" IsCheckable="True" Click="Topmost_Click"/>
                <Separator/>
                <MenuItem Header="إخفاء الويدجت" Click="Hide_Click"/>
            </ContextMenu>
        </Border.ContextMenu>
        <StackPanel>
            <DockPanel>
                <TextBlock x:Name="Date" DockPanel.Dock="Left" Foreground="{DynamicResource HeroMutedBrush}" FontSize="11.5" VerticalAlignment="Center"/>
                <TextBlock x:Name="Clock" Foreground="White" FontSize="30" FontWeight="Bold" FlowDirection="LeftToRight" HorizontalAlignment="Right"/>
            </DockPanel>
            <Border Height="1" Background="#33FFFFFF" Margin="0,6,0,8"/>
            <DockPanel>
                <TextBlock x:Name="Countdown" DockPanel.Dock="Left" Foreground="#E9C75A" FontSize="22" FontWeight="Bold" FlowDirection="LeftToRight" VerticalAlignment="Center"/>
                <StackPanel>
                    <TextBlock x:Name="NextName" Foreground="White" FontSize="14.5" FontWeight="SemiBold"/>
                    <TextBlock x:Name="NextTime" Foreground="{DynamicResource HeroMutedBrush}" FontSize="12"/>
                </StackPanel>
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
