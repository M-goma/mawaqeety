<Window x:Class="Mawaqeety.App.Views.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="سبيل" Width="280" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" ShowActivated="False" FontFamily="{StaticResource AppFont}" FlowDirection="RightToLeft"
        UseLayoutRounding="True">
    <Border x:Name="Card" CornerRadius="18" Background="{DynamicResource HeroBrush}" Padding="16,12,16,14" Margin="8"
            MouseLeftButtonDown="Card_MouseLeftButtonDown" Cursor="SizeAll">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.35"/>
        </Border.Effect>
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="فتح سبيل" Click="Open_Click"/>
                <MenuItem x:Name="TopmostItem" Header="تبقى فوق كل النوافذ" IsCheckable="True" Click="Topmost_Click"/>
                <Separator/>
                <MenuItem Header="إخفاء الويدجت" Click="Hide_Click"/>
            </ContextMenu>
        </Border.ContextMenu>
        <StackPanel>
            <TextBlock x:Name="Clock" Foreground="White" FontSize="32" FontWeight="Bold" FlowDirection="LeftToRight" HorizontalAlignment="Center"/>
            <TextBlock x:Name="Date" Foreground="{DynamicResource HeroMutedBrush}" FontSize="12" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,-2,0,0"/>
            <Border Height="1" Background="#33FFFFFF" Margin="0,8"/>
            <TextBlock x:Name="NextName" Foreground="White" FontSize="13.5" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <TextBlock x:Name="Countdown" Foreground="#E9C75A" FontSize="26" FontWeight="Bold" FlowDirection="LeftToRight" HorizontalAlignment="Center"/>
            <TextBlock x:Name="NextTime" Foreground="{DynamicResource HeroMutedBrush}" FontSize="12" HorizontalAlignment="Center"/>
        </StackPanel>
    </Border>
</Window>
