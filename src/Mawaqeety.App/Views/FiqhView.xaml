<UserControl x:Class="Mawaqeety.App.Views.FiqhView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Mawaqeety.App.Controls">
    <UserControl.Resources>
        <c:BoolToVisibilityConverter x:Key="BoolVis"/>
        <c:NotEmptyToVisibilityConverter x:Key="NotEmpty"/>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,24" MaxWidth="980">
            <Border Style="{StaticResource HeroCard}">
                <DockPanel>
                    <TextBlock Text="⚖️" Style="{StaticResource HeroEmoji}"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Book.Title}" Foreground="{DynamicResource HeroMutedBrush}" FontSize="15"/>
                        <TextBlock Text="{Binding HeroTitle}" Foreground="White" FontSize="22" FontWeight="Bold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Book.Note}" Foreground="#E9C75A" FontSize="13.5" TextWrapping="Wrap" LineHeight="24" Margin="0,4,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <DockPanel Margin="0,0,0,10">
                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding ClearQueryCommand}" ToolTip="مسح البحث" Margin="6,0,0,0"
                        Visibility="{Binding Query, Converter={StaticResource NotEmpty}}">
                    <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"/>
                </Button>
                <Grid>
                    <TextBox x:Name="Search" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" Padding="34,7,10,7" FontSize="14"/>
                    <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False"/>
                    <TextBlock Text="ابحث: التيمم، القصر، زكاة الذهب…" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"
                               Margin="36,0,10,0" IsHitTestVisible="False" Visibility="{Binding Query, Converter={x:Static c:EmptyVisibility.Instance}}"/>
                </Grid>
            </DockPanel>

            <ItemsControl ItemsSource="{Binding Topics}" Margin="0,0,0,12">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <RadioButton Style="{StaticResource Segment}" GroupName="fiqhTopic" Content="{Binding Label}" IsChecked="{Binding IsSelected}" Margin="0,0,6,6"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="20,14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{Binding Header}" Style="{StaticResource Muted}" FontSize="12"/>
                                <TextBlock Text="{Binding Question}" FontWeight="Bold" FontSize="16.5" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                <Border HorizontalAlignment="Left" Margin="0,6,0,0" Padding="8,2" CornerRadius="8" Background="#26FF9800" BorderBrush="#80FF9800" BorderThickness="1"
                                        Visibility="{Binding Khilaf, Converter={StaticResource BoolVis}}">
                                    <TextBlock Text="في المسألة خلاف" FontSize="12" FontWeight="Bold" Foreground="#FF9800"/>
                                </Border>
                                <ItemsControl ItemsSource="{Binding Answers}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,12,0,0" Padding="12,0,0,0" BorderThickness="3,0,0,0"
                                                    BorderBrush="{Binding Color, Converter={x:Static c:HexBrush.Instance}}">
                                                <StackPanel>
                                                    <Border HorizontalAlignment="Left" Padding="8,2" CornerRadius="8" Background="{Binding SoftColor, Converter={x:Static c:HexBrush.Instance}}">
                                                        <TextBlock Text="{Binding Source}" FontSize="12" FontWeight="Bold" Foreground="{Binding Color, Converter={x:Static c:HexBrush.Instance}}"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="15" LineHeight="28" Margin="0,6,0,0"/>
                                                    <DockPanel Margin="0,4,0,0">
                                                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" CommandParameter="{Binding Url}"
                                                                Command="{Binding DataContext.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                Foreground="{Binding Color, Converter={x:Static c:HexBrush.Instance}}" ToolTip="{Binding Url}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xE8A7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,2,6,0"/>
                                                                <TextBlock Text="اقرأ الفتوى كاملة"/>
                                                            </StackPanel>
                                                        </Button>
                                                        <TextBlock Text="{Binding Ref}" Style="{StaticResource Muted}" FontSize="11.5" VerticalAlignment="Center"/>
                                                    </DockPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{Binding Footer}" Style="{StaticResource Muted}" FontSize="12" TextAlignment="Center" Margin="12,4,12,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
