<UserControl x:Class="Mawaqeety.App.Views.QiblaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Mawaqeety.App.Controls">
    <Grid Margin="24,24,24,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}" Margin="0" Padding="20">
            <c:CompassDial Bearing="{Binding Bearing}" MaxWidth="520" MaxHeight="520"/>
        </Border>
        <StackPanel Grid.Column="2">
            <Border Background="{DynamicResource HeroBrush}" Effect="{StaticResource HeroShadow}" BorderBrush="{StaticResource RimBrush}" BorderThickness="0,1,0,0" CornerRadius="18" Padding="22,18">
                <StackPanel>
                    <TextBlock Text="اتجاه القبلة" Foreground="{DynamicResource HeroMutedBrush}" FontSize="14"/>
                    <TextBlock Text="{Binding BearingText}" Foreground="White" FontSize="52" FontWeight="Bold"/>
                    <TextBlock Text="{Binding DirectionText}" Foreground="#E9C75A" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding DistanceText}" Foreground="White" FontSize="14" Margin="0,8,0,0"/>
                    <TextBlock Foreground="{DynamicResource HeroMutedBrush}" FontSize="12.5" Margin="0,4,0,0">
                        <Run Text="من: "/><Run Text="{Binding PlaceText, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="كيف أتوجّه؟" FontWeight="Bold" FontSize="15" Margin="0,0,0,6"/>
                    <TextBlock TextWrapping="Wrap" FontSize="13" LineHeight="24" Foreground="{DynamicResource TextBrush}"
                               Text="الكمبيوتر ليس فيه حساس بوصلة، لذلك تُعرض الزاوية من الشمال الجغرافي (باتجاه عقارب الساعة). اعرف اتجاه الشمال من بوصلة الهاتف أو من الخريطة، ثم انحرف عنه بالزاوية المبيّنة."/>
                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,8,0,0"
                               Text="تُحسب من المدينة المختارة في الإعدادات. ولاتجاه حيّ بدقة استخدم تطبيق مواقيتي على الهاتف."/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
