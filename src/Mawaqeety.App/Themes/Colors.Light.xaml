<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="BgColor">#F3F6F4</Color>
    <SolidColorBrush x:Key="BgBrush" Color="#F3F6F4"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#0B1F3A"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Surface2Brush" Color="#EEF3F0"/>
    <SolidColorBrush x:Key="InputBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="LineBrush" Color="#DCE5E0"/>
    <SolidColorBrush x:Key="TextBrush" Color="#0B1F3A"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#5B6B80"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#0E8A5F"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#0B7A53"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1A0E8A5F"/>
    <SolidColorBrush x:Key="GoldBrush" Color="#B8901F"/>
    <SolidColorBrush x:Key="GoldSoftBrush" Color="#33D4AF37"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#E6EEEA"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#C62828"/>
    <LinearGradientBrush x:Key="HeroBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0E8A5F" Offset="0"/>
        <GradientStop Color="#0B5E52" Offset="0.55"/>
        <GradientStop Color="#0B2A4A" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="HeroTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="HeroMutedBrush" Color="#CCE9DD"/>
    <SolidColorBrush x:Key="ProgressTrackBrush" Color="#33FFFFFF"/>
</ResourceDictionary>
