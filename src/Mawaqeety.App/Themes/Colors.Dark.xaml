<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="BgColor">#07152A</Color>
    <SolidColorBrush x:Key="BgBrush" Color="#07152A"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#0A1C36"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#0F2544"/>
    <SolidColorBrush x:Key="Surface2Brush" Color="#14305A"/>
    <SolidColorBrush x:Key="InputBrush" Color="#0B1F3A"/>
    <SolidColorBrush x:Key="LineBrush" Color="#1E3B66"/>
    <SolidColorBrush x:Key="TextBrush" Color="#F4F7FB"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#9DB0C9"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#12A372"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#18B983"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1A12A372"/>
    <SolidColorBrush x:Key="GoldBrush" Color="#D4AF37"/>
    <SolidColorBrush x:Key="GoldSoftBrush" Color="#26D4AF37"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#163661"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#E5676B"/>
    <LinearGradientBrush x:Key="HeroBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0E8A5F" Offset="0"/>
        <GradientStop Color="#0B5E52" Offset="0.55"/>
        <GradientStop Color="#0B2A4A" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="HeroTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="HeroMutedBrush" Color="#CCE9DD"/>
    <SolidColorBrush x:Key="ProgressTrackBrush" Color="#33FFFFFF"/>
</ResourceDictionary>
